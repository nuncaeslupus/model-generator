# .gitignore for a model-generator project.
#
# This mirrors what `model-gen` emits at the project root. Note what is NOT
# ignored: the generated src/, tests/, and alembic/ trees. The generated code
# is YOURS — commit it and evolve it by hand (see the project philosophy).
# Only build artifacts, caches, virtualenvs, and secrets are ignored.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/

# Linting
.ruff_cache/

# Mutation testing
mutants/
mutmut-stats.json

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment variables
.env
.env.local
