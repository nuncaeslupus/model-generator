{
    "$schema": "../../../src/model_generator/schema/model.schema.json",
    "domain": "portfolio",
    "description": "Portfolio management and transaction tracking entities - demonstrates financial types, percentages, immutability, and cross-field constraints",
    "section_header": "PORTFOLIO & TRANSACTION MODELS",
    "entities": {
        "Portfolio": {
            "table": "portfolios",
            "description": "User investment portfolio with financial tracking",
            "fields": {
                "id": {
                    "type": "uuid",
                    "primary_key": true,
                    "auto_generate": true,
                    "description": "Unique portfolio identifier"
                },
                "user_id": {
                    "type": "reference",
                    "reference_table": "users",
                    "required": true,
                    "on_delete": "CASCADE",
                    "api_exclude_update": true,
                    "description": "Owner of this portfolio"
                },
                "name": {
                    "type": "text",
                    "max_length": 100,
                    "required": true,
                    "description": "Portfolio display name"
                },
                "balance": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "required": true,
                    "default": "0.00000000",
                    "constraints": [
                        {
                            "type": "non_negative"
                        }
                    ],
                    "description": "Total portfolio value in base currency (supports crypto precision)"
                },
                "available_balance": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "required": true,
                    "default": "0.00000000",
                    "constraints": [
                        {
                            "type": "non_negative"
                        }
                    ],
                    "description": "Available balance (not locked in orders)"
                },
                "target_allocation": {
                    "type": "json_object",
                    "description": "Target asset allocation strategy (e.g., {\"stocks\": 60, \"bonds\": 30, \"cash\": 10})"
                },
                "settings": {
                    "type": "json_object",
                    "description": "Additional portfolio settings and configuration"
                },
                "is_active": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether portfolio is currently active for trading"
                }
            },
            "timestamps": {
                "created": true,
                "updated": true
            },
            "relationships": {
                "user": {
                    "type": "many_to_one",
                    "target": "User",
                    "back_populates": "portfolios"
                },
                "assets": {
                    "type": "one_to_many",
                    "target": "PortfolioAsset",
                    "back_populates": "portfolio",
                    "cascade": "all, delete-orphan"
                },
                "transactions": {
                    "type": "one_to_many",
                    "target": "Transaction",
                    "back_populates": "portfolio",
                    "cascade": "all, delete-orphan"
                }
            },
            "cross_field_constraints": [
                {
                    "type": "field_less_than_or_equal",
                    "name": "available_balance_less_equal_balance",
                    "description": "Available balance cannot exceed total balance",
                    "fields": [
                        "available_balance",
                        "balance"
                    ],
                    "message": "Available balance cannot exceed total balance"
                }
            ],
            "indexes": [
                {
                    "fields": [
                        "user_id"
                    ]
                },
                {
                    "fields": [
                        "is_active"
                    ]
                },
                {
                    "fields": [
                        "user_id",
                        "name"
                    ],
                    "unique": true
                }
            ],
            "api": {
                "scope": {"owner_field": "user_id"},
                "enabled": true,
                "prefix": "portfolios",
                "endpoints": [
                    "list",
                    "create",
                    "get",
                    "update",
                    "delete"
                ],
                "pagination": true
            },
            "tests": {
                "enabled": true
            }
        },
        "PortfolioAsset": {
            "table": "portfolio_assets",
            "description": "Individual asset holdings within a portfolio - demonstrates percentage type and cross-field validation",
            "fields": {
                "id": {
                    "type": "uuid",
                    "primary_key": true,
                    "auto_generate": true,
                    "description": "Unique asset holding identifier"
                },
                "portfolio_id": {
                    "type": "reference",
                    "reference_table": "portfolios",
                    "required": true,
                    "on_delete": "CASCADE",
                    "api_exclude_update": true,
                    "description": "Portfolio containing this asset"
                },
                "symbol": {
                    "type": "text",
                    "max_length": 20,
                    "required": true,
                    "description": "Asset symbol (e.g., BTC, ETH, AAPL)"
                },
                "quantity": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "required": true,
                    "default": "0.00000000",
                    "constraints": [
                        {
                            "type": "non_negative"
                        }
                    ],
                    "description": "Amount of asset held"
                },
                "average_cost": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "required": true,
                    "default": "0.00000000",
                    "constraints": [
                        {
                            "type": "non_negative"
                        }
                    ],
                    "description": "Average purchase price per unit"
                },
                "current_price": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "description": "Current market price (cached, updated periodically)"
                },
                "allocation_percentage": {
                    "type": "percentage",
                    "description": "Target allocation for rebalancing as a 0.0-1.0 fraction (e.g. 0.25 = 25%)"
                }
            },
            "timestamps": {
                "created": true,
                "updated": true
            },
            "relationships": {
                "portfolio": {
                    "type": "many_to_one",
                    "target": "Portfolio",
                    "back_populates": "assets"
                }
            },
            "indexes": [
                {
                    "fields": [
                        "portfolio_id"
                    ]
                },
                {
                    "fields": [
                        "symbol"
                    ]
                },
                {
                    "fields": [
                        "portfolio_id",
                        "symbol"
                    ],
                    "unique": true
                }
            ],
            "api": {
                "enabled": true,
                "prefix": "portfolio-assets",
                "endpoints": [
                    "list",
                    "create",
                    "get",
                    "update",
                    "delete"
                ],
                "pagination": true
            },
            "tests": {
                "enabled": true
            }
        },
        "Transaction": {
            "table": "transactions",
            "description": "Immutable financial transaction record - demonstrates immutable mutability and financial precision",
            "mutability": "immutable",
            "fields": {
                "id": {
                    "type": "uuid",
                    "primary_key": true,
                    "auto_generate": true,
                    "description": "Unique transaction identifier"
                },
                "portfolio_id": {
                    "type": "reference",
                    "reference_table": "portfolios",
                    "required": true,
                    "on_delete": "CASCADE",
                    "description": "Portfolio this transaction belongs to"
                },
                "type": {
                    "type": "enum",
                    "enum_name": "TransactionType",
                    "enum_existing": true,
                    "required": true,
                    "description": "Transaction type (DEPOSIT, WITHDRAWAL, BUY, SELL, TRANSFER)"
                },
                "symbol": {
                    "type": "text",
                    "max_length": 20,
                    "description": "Asset symbol (for BUY/SELL transactions)"
                },
                "amount": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "required": true,
                    "description": "Transaction amount (positive for credits, negative for debits)"
                },
                "quantity": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "description": "Asset quantity (for BUY/SELL transactions)"
                },
                "price": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "description": "Price per unit (for BUY/SELL transactions)"
                },
                "fee": {
                    "type": "financial",
                    "precision": 18,
                    "scale": 8,
                    "default": "0.00000000",
                    "constraints": [
                        {
                            "type": "non_negative"
                        }
                    ],
                    "description": "Transaction fee charged"
                },
                "status": {
                    "type": "enum",
                    "enum_name": "TransactionStatus",
                    "enum_existing": true,
                    "required": true,
                    "default": "PENDING",
                    "description": "Transaction status (PENDING, COMPLETED, FAILED, CANCELLED)"
                },
                "reference_id": {
                    "type": "text",
                    "max_length": 100,
                    "description": "External reference or order ID"
                },
                "notes": {
                    "type": "longtext",
                    "description": "Additional transaction notes"
                },
                "extra_data": {
                    "type": "json_object",
                    "description": "Additional transaction data (exchange info, blockchain details, etc.)"
                },
                "completed_at": {
                    "type": "datetime",
                    "description": "When transaction was completed"
                }
            },
            "timestamps": {
                "created": true,
                "updated": false
            },
            "relationships": {
                "portfolio": {
                    "type": "many_to_one",
                    "target": "Portfolio",
                    "back_populates": "transactions"
                }
            },
            "indexes": [
                {
                    "fields": [
                        "portfolio_id"
                    ]
                },
                {
                    "fields": [
                        "type"
                    ]
                },
                {
                    "fields": [
                        "status"
                    ]
                },
                {
                    "fields": [
                        "symbol"
                    ]
                },
                {
                    "fields": [
                        "created_at"
                    ]
                },
                {
                    "fields": [
                        "reference_id"
                    ]
                },
                {
                    "fields": [
                        "portfolio_id",
                        "created_at"
                    ]
                }
            ],
            "constraints": [
                {
                    "type": "check",
                    "name": "ck_transactions_amount_non_negative",
                    "expression": "CAST(amount AS NUMERIC) >= 0"
                },
                {
                    "type": "unique",
                    "fields": ["portfolio_id", "reference_id"]
                }
            ],
            "api": {
                "enabled": true,
                "prefix": "transactions",
                "endpoints": [
                    "list",
                    "create",
                    "get"
                ],
                "pagination": true
            },
            "tests": {
                "enabled": true
            }
        }
    }
}