import os
import tempfile
from collections.abc import AsyncGenerator, Generator
from typing import Any

import pytest
from fastapi.testclient import TestClient
from sqlalchemy import create_engine
from sqlalchemy.ext.asyncio import AsyncSession, async_sessionmaker, create_async_engine
from sqlalchemy.orm import sessionmaker

from {{ database_models_import }}.base import Base
{% if auth_strategy == 'bcrypt-session' %}

# Default the auth env (password pepper + cookie-signing secret) BEFORE the app
# is imported — the auth router builds its signed-cookie serializer at import
# time. These defaults keep the generated contract suite green without a manual
# export; real deployments provide them via the environment/secrets. `app` and
# `get_session` are imported lazily in the client fixture (below) so this runs
# first.
os.environ.setdefault("{{ pepper_env }}", "test-pepper-not-for-production")
os.environ.setdefault("SESSION_SECRET_KEY", "test-session-secret-not-for-production")
{% else %}
from {{ main_import }} import app
from {{ engine_import }} import get_session
{% endif %}


@pytest.fixture(scope="session")
def client() -> Generator[TestClient, None, None]:
    """
    TestClient fixture with database dependency override.

    Creates a single in-memory SQLite database for the entire test session.
    Tests don't conflict because:
    - UUID primary keys are unique per test
    - Unique string fields use unique_suffix = str(uuid.uuid4())[:8]

    With xdist parallel testing, each worker gets its own session-scoped database.
    """
{% if auth_strategy == 'bcrypt-session' %}
    # Imported here, not at module top, so the auth env defaults set above are
    # applied before the auth router's import-time serializer construction.
    from {{ main_import }} import app
    from {{ engine_import }} import get_session

{% endif %}
    # Create temporary database file
    fd, db_path = tempfile.mkstemp(suffix=".db")
    os.close(fd)

    sync_url = f"sqlite:///{db_path}"
    async_url = f"sqlite+aiosqlite:///{db_path}"

    # Create sync engine for table setup
    sync_engine = create_engine(
        sync_url,
        connect_args={"check_same_thread": False},
    )

    # Create async engine for API operations
    async_engine = create_async_engine(
        async_url,
        connect_args={"check_same_thread": False},
    )

    async_session_local = async_sessionmaker(
        async_engine, class_=AsyncSession, expire_on_commit=False
    )

    # Create all tables
    Base.metadata.create_all(bind=sync_engine)

    # Bind factories to a sync session so tests can seed rows directly — needed
    # for read-only entities (no create endpoint) to exercise get-by-id and
    # response-shape. Writes land in the same database file the async app reads.
    seed_session = sessionmaker(bind=sync_engine)()
    for _factory_cls in _get_factory_classes():
        _factory_cls._meta.sqlalchemy_session = seed_session

    async def override_get_session() -> AsyncGenerator[AsyncSession, None]:
        async with async_session_local() as session:
            yield session

    app.dependency_overrides[get_session] = override_get_session

    with TestClient(app) as test_client:
        yield test_client

    app.dependency_overrides.clear()

    # Cleanup
    seed_session.close()
    sync_engine.dispose()

    # Remove temporary database
    try:
        os.unlink(db_path)
    except OSError:
        pass


def _get_factory_classes() -> list[Any]:
    """Import and return all factory classes."""
    factories = []
    try:
        import factory
{% for domain in domains %}
        from {{ factories_import }} import {{ domain }} as {{ domain }}_factories
        for name in dir({{ domain }}_factories):
            obj = getattr({{ domain }}_factories, name)
            if isinstance(obj, type) and issubclass(obj, factory.alchemy.SQLAlchemyModelFactory):
                factories.append(obj)
{% endfor %}
    except ImportError:
        pass  # Factories not generated yet
    return factories


def pytest_configure(config: pytest.Config) -> None:
    """Suppress known third-party deprecation warnings."""
    config.addinivalue_line(
        "filterwarnings",
        "ignore:There is no current event loop:DeprecationWarning",
    )
