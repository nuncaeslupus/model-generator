    def test_get_{{ entity.table }}_list_success(self, client: TestClient) -> None:
        """Test GET /api/v1/{{ entity_table_kebab }} returns paginated list."""
        response = client.get("/api/v1/{{ entity_table_kebab }}")

        assert response.status_code == 200
        data = response.json()
        assert isinstance(data, dict)
        assert "items" in data
        assert "page_info" in data
        assert isinstance(data["items"], list)

        # Verify pagination metadata structure
        page_info = data["page_info"]
        assert "page" in page_info
        assert "page_size" in page_info
        assert "total_items" in page_info
        assert "total_pages" in page_info
        assert "has_next" in page_info
        assert "has_prev" in page_info
        assert page_info["page"] == 1
        assert page_info["has_prev"] is False

    def test_get_{{ entity.table }}_list_pagination(self, client: TestClient) -> None:
        """Test pagination parameters for GET /api/v1/{{ entity_table_kebab }}."""
        # Test with custom page size
        response = client.get("/api/v1/{{ entity_table_kebab }}?page=1&page_size=10")

        assert response.status_code == 200
        data = response.json()
        assert data["page_info"]["page"] == 1
        assert data["page_info"]["page_size"] == 10
        assert len(data["items"]) <= 10

    def test_get_{{ entity.table }}_list_invalid_pagination(self, client: TestClient) -> None:
        """Test invalid pagination parameters are rejected."""
        # Page must be >= 1
        response = client.get("/api/v1/{{ entity_table_kebab }}?page=0")
        assert response.status_code in (400, 422)  # FastAPI validation error

        # Page size must be >= 1 and <= 1000
        response = client.get("/api/v1/{{ entity_table_kebab }}?page_size=0")
        assert response.status_code in (400, 422)  # FastAPI validation error

        response = client.get("/api/v1/{{ entity_table_kebab }}?page_size=1001")
        assert response.status_code in (400, 422)  # FastAPI validation error

