{#-
  API Route Template (Multi-Entity)
  Generates FastAPI routes for all entities in a domain
-#}
{% from "_shared/_base.j2" import generated_marker, section_banner %}
{#- Helper macros -#}
{% macro entity_name_plural(entity_name) -%}
{%- if entity_name.endswith('y') -%}
{{ entity_name[:-1] }}ies
{%- elif entity_name.endswith('s') -%}
{{ entity_name }}es
{%- else -%}
{{ entity_name }}s
{%- endif -%}
{%- endmacro %}

{#- Get primary key field name -#}
{% macro get_pk_field(entity) -%}
{%- for field_name, field in entity.fields.items() -%}
{%- if field.primary_key | default(false) -%}
{{ field_name }}
{%- endif -%}
{%- endfor -%}
{%- endmacro %}

{#- Scan all entities to determine required imports -#}
{% set ns = namespace(
    has_integrity_error=false,
    has_any=false,
    has_financial=false,
    has_percentage=false,
    has_datetime=false,
    needs_isoformat=false,
    has_uuid_pk=false,
    needs_uuid_filter=false,
    enum_imports=[],
    db_models=[],
    has_password_field=false,
    has_scoped_endpoints=false,
    has_auth_gate=false,
    scope_miss_status=[]
) %}
{% for entity_name, entity in model.entities.items() %}
{% set _ = ns.db_models.append(entity_name) %}
{% if entity.api is defined and entity.api.scope is defined %}
{% set ns.has_scoped_endpoints = true %}
{% if entity.api.scope.miss_status is defined and entity.api.scope.miss_status != 404 and entity.api.scope.miss_status not in ns.scope_miss_status %}
{% set _ = ns.scope_miss_status.append(entity.api.scope.miss_status) %}
{% endif %}
{% endif %}
{% if entity.api is defined and entity.api.require_auth | default(false) %}
{% set ns.has_auth_gate = true %}
{% endif %}
{% for field_name, field in entity.fields.items() %}
{% if field.type == 'uuid' and field.primary_key | default(false) %}{% set ns.has_uuid_pk = true %}{% endif %}
{% if field.type == 'reference' and (field.reference_column | default('id')) == 'id' and not field.api_exclude_response | default(false) and not field.primary_key | default(false) %}{% set ns.needs_uuid_filter = true %}{% endif %}
{% if field.type in ['json_object', 'json_array'] %}{% set ns.has_any = true %}{% endif %}
{% if field.type == 'financial' %}{% set ns.has_financial = true %}{% endif %}
{% if field.type == 'percentage' %}{% set ns.has_percentage = true %}{% endif %}
{% if field.type == 'datetime' %}{% set ns.has_datetime = true %}{% set ns.needs_isoformat = true %}{% endif %}
{% if field.type == 'enum' and field.enum_name not in ns.enum_imports %}
{% set _ = ns.enum_imports.append(field.enum_name) %}
{% endif %}
{% if field_name == 'password_hash' %}{% set ns.has_password_field = true %}{% endif %}
{% endfor %}
{% if entity.timestamps is defined and (entity.timestamps.created | default(false) or entity.timestamps.updated | default(false)) %}{% set ns.needs_isoformat = true %}{% endif %}
{% endfor %}
{{ generated_marker() }}

"""
API routes for {{ model.section_header | default(model.domain | upper) }}.

{{ model.description | default('API routes for ' + model.domain + ' domain.') | wrap(88) }}

Provides complete CRUD operations for:
{% for entity_name, entity in model.entities.items() %}
- {{ entity_name }}: {{ entity.description | default('Manage ' + entity_name + ' records') | truncate(60, true) }}
{% endfor %}

All endpoints follow RESTful conventions and return standardized error responses.
"""
{% if ns.has_password_field %}
import bcrypt
{% endif %}
{% if ns.has_datetime %}
from datetime import datetime, timezone
{% endif %}
{% if ns.has_financial or ns.has_percentage %}
from decimal import Decimal
{% endif %}
{% if ns.has_uuid_pk or ns.needs_uuid_filter %}
from uuid import UUID
{% endif %}

from fastapi import APIRouter, Depends, Response, Query
from fastapi import status as http_status
{% if ns.scope_miss_status | length > 0 %}
from fastapi import HTTPException
{% endif %}
from sqlalchemy import select, func
from sqlalchemy.exc import IntegrityError
from sqlalchemy.ext.asyncio import AsyncSession
from typing import Any

from {{ config.paths.api_models.rsplit('/', 1)[0] | path_to_import }}.errors import format_integrity_error, format_not_found_error
from {{ config.paths.api_models | path_to_import }}.pagination import PaginatedResponse, calculate_page_info
{% set utils_imports = [] %}
{% if ns.has_financial or ns.has_percentage %}{% set _ = utils_imports.append('normalize_decimal') %}{% endif %}
{% if ns.needs_isoformat %}{% set _ = utils_imports.append('isoformat_utc') %}{% endif %}
{% if utils_imports %}
from {{ config.paths.api_models.rsplit('/', 1)[0] | path_to_import }}.utils import {{ utils_imports | join(', ') }}

{% endif %}
from {{ config.paths.database_models.rsplit('/', 1)[0] | path_to_import }} import get_session
{% if config.get('generation', {}).get('layout', 'per-entity') == 'per-entity' %}
{% for entity_name in ns.db_models %}
from {{ config.paths.database_models | path_to_import }}.{{ entity_name | snake_case }} import {{ entity_name }}
{% endfor %}
{% else %}
from {{ config.paths.database_models | path_to_import }}.{{ model.domain }} import {{ ns.db_models | join(', ') }}
{% endif %}
{% if ns.enum_imports | length > 0 %}
from {{ config.paths.database_models | path_to_import }}.enums import {{ ns.enum_imports | join(', ') }}
{% endif %}
{#- Auth dependency: get_current_user (scope) or require_api_key (api-key gate).
    Hoisted so both the import below and the per-route decorators can use it. -#}
{% set auth_dep_path = (config.get('auth') or {}).get('dependency_path') %}
{% set auth_dep_func = auth_dep_path.rsplit('.', 1)[1] if auth_dep_path else none %}
{% if (ns.has_scoped_endpoints or ns.has_auth_gate) and auth_dep_path %}
from {{ auth_dep_path.rsplit('.', 1)[0] }} import {{ auth_dep_func }}
{% endif %}

# Import request models
{% set is_per_entity = config.get('generation', {}).get('layout', 'per-entity') == 'per-entity' %}
{% for entity_name, entity in model.entities.items() %}
{% set req_module = (entity_name | snake_case) if is_per_entity else model.domain %}
from {{ config.paths.api_models | path_to_import }}.{{ req_module }}_requests import Create{{ entity_name }}Request{% if entity.mutability | default('mutable') != 'immutable' %}, Update{{ entity_name }}Request{% endif %}

{% endfor %}

# Import response models
{% if is_per_entity %}
{% for entity_name, entity in model.entities.items() %}
from {{ config.paths.api_models | path_to_import }}.{{ entity_name | snake_case }}_response import {{ entity_name }}Response
{% endfor %}
{% else %}
from {{ config.paths.api_models | path_to_import }}.{{ model.domain }}_response import (
{% for entity_name, entity in model.entities.items() %}
    {{ entity_name }}Response,
{% endfor %}
)
{% endif %}

router = APIRouter(tags=["{{ model.domain }}"])

{% for entity_name, entity in model.entities.items() %}
{% set entity_lower = entity_name | lower %}
{% set entity_plural = entity.table | default(entity_lower + 's') %}
{%- set entity_plural_kebab = entity_plural.replace('_', '-') -%}
{% set pk_field = get_pk_field(entity) | trim %}
{% set pk_type = entity.fields[pk_field].type if pk_field else 'uuid' %}
{% set pk_python_type = 'int' %}
{% if pk_type == 'uuid' %}
{% set pk_python_type = 'UUID' %}
{% elif pk_type in ['text', 'reference'] %}
{% set pk_python_type = 'str' %}
{% endif %}
{% set endpoints = entity.api.endpoints if (entity.api is defined and entity.api.endpoints is defined) else ["list", "create", "get", "update", "delete"] %}
{% set scope = entity.api.scope if entity.api is defined else none %}
{#- api.filters whitelist: when set, only those field names get filter params on
    the list endpoint. When absent (none), the auto-detection logic applies. -#}
{% set api_filters = entity.api.filters if (entity.api is defined and entity.api.filters is defined) else none %}
{% if scope %}
{% set inject_from = scope.inject_from | default('current_user') %}
{% set miss_status = scope.miss_status | default(404) %}
{% endif %}
{#- api-key gate: protect every route of this entity with the shared-key
    dependency. Orthogonal to scope (which injects an owner via the signature);
    here we only need a route-level dependency, so it rides on the decorator. -#}
{% set require_auth = (entity.api.require_auth | default(false)) if entity.api is defined else false %}
{% set auth_dep_arg = ', dependencies=[Depends(' ~ auth_dep_func ~ ')]' if (require_auth and auth_dep_func) else '' %}

{{ section_banner(entity_name + ' CRUD OPERATIONS') }}


{% if "list" in endpoints %}
# ----- SECTION 1: {{ entity_name }} List Operations -----

@router.get("/{{ entity_plural_kebab }}", response_model=PaginatedResponse[{{ entity_name }}Response]{{ auth_dep_arg }})
async def list_{{ entity_plural }}(
    page: int = Query(1, ge=1, description="Page number (1-indexed)"),
    page_size: int = Query(50, ge=1, le=1000, description="Items per page"),
{% for field_name, field in entity.fields.items() %}
{% if not field.api_exclude_response | default(false) and not field.primary_key | default(false) %}
{% if api_filters is none or field_name in api_filters %}
{% if field.type == 'enum' %}
    {{ field_name }}: {{ field.enum_name }} | None = Query(None, description="Filter by {{ field_name }}"),
{% elif field.type == 'boolean' %}
    {{ field_name }}: bool | None = Query(None, description="Filter by {{ field_name }}"),
{% elif field.type == 'datetime' %}
    {{ field_name }}_after: datetime | None = Query(None, description="Filter {{ field_name }} after this datetime (ISO 8601)"),
    {{ field_name }}_before: datetime | None = Query(None, description="Filter {{ field_name }} before this datetime (ISO 8601)"),
{% elif field.type in ['financial', 'percentage'] %}
    {{ field_name }}_min: Decimal | None = Query(None, description="Filter {{ field_name }} minimum value"),
    {{ field_name }}_max: Decimal | None = Query(None, description="Filter {{ field_name }} maximum value"),
{% elif field.type == 'counter' %}
    {{ field_name }}_min: int | None = Query(None, description="Filter {{ field_name }} minimum value"),
    {{ field_name }}_max: int | None = Query(None, description="Filter {{ field_name }} maximum value"),
{% elif field.type == 'reference' %}
{% if (field.reference_column | default('id')) == 'id' %}
    {{ field_name }}: UUID | None = Query(None, description="Filter by {{ field_name }}"),
{% else %}
    {{ field_name }}: str | None = Query(None, description="Filter by {{ field_name }}"),
{% endif %}
{% elif field.type == 'text' and field.unique | default(false) %}
    {{ field_name }}: str | None = Query(None, description="Filter by {{ field_name }}"),
{% endif %}
{% endif %}
{% endif %}
{% endfor %}
    sort_by: str | None = Query(None, description="Sort by field name"),
    order: str = Query("desc", pattern="^(asc|desc)$", description="Sort order (asc or desc)"),
    session: AsyncSession = Depends(get_session),
{% if scope %}
    {{ inject_from }}: Any = Depends({{ auth_dep_func }}),
{% endif %}
) -> PaginatedResponse[{{ entity_name }}Response]:
    """List {{ entity_plural }} with pagination, filtering, and sorting."""
    # Build base query
    stmt = select({{ entity_name }})
    count_stmt = select(func.count()).select_from({{ entity_name }})

{% if scope %}
    # Apply ownership scope
    stmt = stmt.where({{ entity_name }}.{{ scope.owner_field }} == {{ inject_from }}.id)
    count_stmt = count_stmt.where({{ entity_name }}.{{ scope.owner_field }} == {{ inject_from }}.id)
{% endif %}

    # Apply filters
{% for field_name, field in entity.fields.items() %}
{% if not field.api_exclude_response | default(false) and not field.primary_key | default(false) %}
{% if api_filters is none or field_name in api_filters %}
{% if field.type == 'enum' %}
    if {{ field_name }} is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
{% elif field.type == 'boolean' %}
    if {{ field_name }} is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
{% elif field.type == 'datetime' %}
    if {{ field_name }}_after is not None:
        # Localize a naive value to UTC: the column is tz-aware, and comparing
        # it against a naive datetime raises on strict drivers (asyncpg/psycopg2).
        if {{ field_name }}_after.tzinfo is None:
            {{ field_name }}_after = {{ field_name }}_after.replace(tzinfo=timezone.utc)
        stmt = stmt.where({{ entity_name }}.{{ field_name }} >= {{ field_name }}_after)
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} >= {{ field_name }}_after)
    if {{ field_name }}_before is not None:
        if {{ field_name }}_before.tzinfo is None:
            {{ field_name }}_before = {{ field_name }}_before.replace(tzinfo=timezone.utc)
        stmt = stmt.where({{ entity_name }}.{{ field_name }} <= {{ field_name }}_before)
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} <= {{ field_name }}_before)
{% elif field.type in ['financial', 'percentage'] %}
    if {{ field_name }}_min is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} >= {{ field_name }}_min)
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} >= {{ field_name }}_min)
    if {{ field_name }}_max is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} <= {{ field_name }}_max)
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} <= {{ field_name }}_max)
{% elif field.type == 'counter' %}
    if {{ field_name }}_min is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} >= {{ field_name }}_min)
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} >= {{ field_name }}_min)
    if {{ field_name }}_max is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} <= {{ field_name }}_max)
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} <= {{ field_name }}_max)
{% elif field.type == 'reference' %}
    if {{ field_name }} is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
{% elif field.type == 'text' and field.unique | default(false) %}
    if {{ field_name }} is not None:
        stmt = stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
        count_stmt = count_stmt.where({{ entity_name }}.{{ field_name }} == {{ field_name }})
{% endif %}
{% endif %}
{% endif %}
{% endfor %}

    # Apply sorting
    if sort_by:
        # Validate sort_by is an actual field
        valid_fields = {
{%- for field_name, field in entity.fields.items() %}
{%- if not field.api_exclude_response | default(false) %}
            "{{ field_name }}",
{%- endif %}
{%- endfor %}
{% if entity.timestamps.created | default(false) %}
            "created_at",
{% endif %}
{% if entity.timestamps.updated | default(false) %}
            "updated_at",
{% endif %}
        }
        if sort_by in valid_fields:
            sort_column = getattr({{ entity_name }}, sort_by)
            stmt = stmt.order_by(sort_column.desc() if order == "desc" else sort_column.asc())
        else:
            raise HTTPException(
                status_code=422,
                detail=f"Invalid sort_by value: '{sort_by}'. Valid fields: {', '.join(sorted(valid_fields))}",
            )
{% if entity.timestamps.created | default(false) %}
    else:
        # Default sort by created_at descending
        stmt = stmt.order_by({{ entity_name }}.created_at.desc())
{% endif %}

    # Get total count with filters applied
    total_result = await session.execute(count_stmt)
    total_items = total_result.scalar_one()

    # Get paginated items
    offset = (page - 1) * page_size
    stmt = stmt.offset(offset).limit(page_size)
    result = await session.execute(stmt)
    items = result.scalars().all()

    # Convert to response models
    response_items = [_convert_{{ entity_lower }}_to_response(item) for item in items]

    # Calculate pagination metadata
    page_info = calculate_page_info(page, page_size, total_items)

    return PaginatedResponse(items=response_items, page_info=page_info)
{% endif %}


{% if "create" in endpoints %}
# ----- SECTION 2: {{ entity_name }} Create Operations -----

@router.post("/{{ entity_plural_kebab }}", response_model={{ entity_name }}Response, status_code=http_status.HTTP_201_CREATED{{ auth_dep_arg }})
async def create_{{ entity_lower }}(
    request: Create{{ entity_name }}Request,
    session: AsyncSession = Depends(get_session),
{% if scope %}
    {{ inject_from }}: Any = Depends({{ auth_dep_func }}),
{% endif %}
) -> {{ entity_name }}Response:
    """Create new {{ entity_lower }}."""
    # TODO: Add any business logic validation here
    # Check tests/contract/api/test_{{ model.domain }}_custom.py for custom logic
{% if 'password_hash' in entity.fields %}

    # Handle password hashing (password field in request -> password_hash in DB)
    # bcrypt has a 72-byte limit, truncate if necessary
    password_bytes = request.password.encode("utf-8")[:72]
    password_hash = bcrypt.hashpw(password_bytes, bcrypt.gensalt()).decode("utf-8")
    {{ entity_lower }}_data = request.model_dump(exclude={"password"})
    {{ entity_lower }} = {{ entity_name }}(**{{ entity_lower }}_data, password_hash=password_hash)
{% else %}

    {{ entity_lower }} = {{ entity_name }}(**request.model_dump())
{% endif %}
{% if scope %}
    {{ entity_lower }}.{{ scope.owner_field }} = {{ inject_from }}.id
{% endif %}
    session.add({{ entity_lower }})

    try:
        await session.commit()
        await session.refresh({{ entity_lower }})
        return _convert_{{ entity_lower }}_to_response({{ entity_lower }})
    except IntegrityError as e:
        await session.rollback()
        raise format_integrity_error(e, "{{ entity_name }}") from None
{% endif %}


{% if "get" in endpoints %}
# ----- SECTION 3: {{ entity_name }} Individual Read Operations -----

@router.get("/{{ entity_plural_kebab }}/{{ '{' }}{{ pk_field }}{{ '}' }}", response_model={{ entity_name }}Response{{ auth_dep_arg }})
async def get_{{ entity_lower }}(
    {{ pk_field }}: {{ pk_python_type }},
    session: AsyncSession = Depends(get_session),
{% if scope %}
    {{ inject_from }}: Any = Depends({{ auth_dep_func }}),
{% endif %}
) -> {{ entity_name }}Response:
    """Get single {{ entity_lower }} by ID."""
    {{ entity_lower }} = await session.get({{ entity_name }}, {{ pk_field }})
    if not {{ entity_lower }}:
        raise format_not_found_error("{{ entity_name }}", {{ pk_field }})
{% if scope %}
    if {{ entity_lower }}.{{ scope.owner_field }} != {{ inject_from }}.id:
{% if miss_status == 404 %}
        raise format_not_found_error("{{ entity_name }}", {{ pk_field }})
{% else %}
        raise HTTPException(
            status_code={{ miss_status }},
            detail={"error": "forbidden", "message": "Access denied to this {{ entity_name }}"},
        )
{% endif %}
{% endif %}
    return _convert_{{ entity_lower }}_to_response({{ entity_lower }})
{% endif %}

{% if "update" in endpoints and entity.mutability | default('mutable') != 'immutable' %}

# ----- SECTION 4: {{ entity_name }} Update Operations -----

@router.put("/{{ entity_plural_kebab }}/{{ '{' }}{{ pk_field }}{{ '}' }}", response_model={{ entity_name }}Response{{ auth_dep_arg }})
async def update_{{ entity_lower }}(
    {{ pk_field }}: {{ pk_python_type }},
    request: Update{{ entity_name }}Request,
    session: AsyncSession = Depends(get_session),
{% if scope %}
    {{ inject_from }}: Any = Depends({{ auth_dep_func }}),
{% endif %}
) -> {{ entity_name }}Response:
    """Update existing {{ entity_lower }}."""
    {{ entity_lower }} = await session.get({{ entity_name }}, {{ pk_field }})
    if not {{ entity_lower }}:
        raise format_not_found_error("{{ entity_name }}", {{ pk_field }})
{% if scope %}
    if {{ entity_lower }}.{{ scope.owner_field }} != {{ inject_from }}.id:
{% if miss_status == 404 %}
        raise format_not_found_error("{{ entity_name }}", {{ pk_field }})
{% else %}
        raise HTTPException(
            status_code={{ miss_status }},
            detail={"error": "forbidden", "message": "Access denied to this {{ entity_name }}"},
        )
{% endif %}
{% endif %}

    # Partial updates (only provided fields)
    update_data = request.model_dump(exclude_unset=True)
    for field, value in update_data.items():
        setattr({{ entity_lower }}, field, value)

    try:
        await session.commit()
        await session.refresh({{ entity_lower }})
        return _convert_{{ entity_lower }}_to_response({{ entity_lower }})
    except IntegrityError as e:
        await session.rollback()
        raise format_integrity_error(e, "{{ entity_name }}") from None
{% endif %}


