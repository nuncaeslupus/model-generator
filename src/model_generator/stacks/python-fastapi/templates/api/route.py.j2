# ----- SECTION 5: {{ entity_name }} Delete Operations -----

@router.delete("/{{ entity_plural_kebab }}/{{ '{' }}{{ pk_field }}{{ '}' }}", status_code=http_status.HTTP_204_NO_CONTENT, response_model=None{{ auth_dep_arg }})
async def delete_{{ entity_lower }}(
    {{ pk_field }}: {{ pk_python_type }},
    session: AsyncSession = Depends(get_session),
{% if scope %}
    {{ inject_from }}: Any = Depends({{ auth_dep_func }}),
{% endif %}
) -> Response:
    """Delete {{ entity_lower }}."""
    {{ entity_lower }} = await session.get({{ entity_name }}, {{ pk_field }})
    if not {{ entity_lower }}:
        raise format_not_found_error("{{ entity_name }}", {{ pk_field }})
{% if scope %}
    if {{ entity_lower }}.{{ scope.owner_field }} != {{ inject_from }}.id:
{% if miss_status == 404 %}
        raise format_not_found_error("{{ entity_name }}", {{ pk_field }})
{% else %}
        raise HTTPException(
