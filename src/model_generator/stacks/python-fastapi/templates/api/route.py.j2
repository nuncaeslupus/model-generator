{{ section_banner('HELPER FUNCTIONS') }}

{% for entity_name, entity in model.entities.items() %}
{% set entity_lower = entity_name | lower %}

def _convert_{{ entity_lower }}_to_response({{ entity_lower }}: {{ entity_name }}) -> {{ entity_name }}Response:
    """
    Convert SQLAlchemy {{ entity_name }} model to Pydantic {{ entity_name }}Response model.

    Handles type conversions:
{% for field_name, field in entity.fields.items() %}
{% if field.api_exclude_response | default(false) %}
    - {{ field_name }}: excluded from response
{% elif field.type == 'datetime' %}
    - {{ field_name }}: Convert datetime to ISO 8601 string
{% elif field.type == 'financial' %}
    - {{ field_name }}: Convert Decimal to string with 2 decimal places minimum
{% elif field.type == 'percentage' %}
    - {{ field_name }}: Convert Decimal to string with variable precision
{% elif field.type == 'enum' %}
    - {{ field_name }}: Enum value
{% endif %}
{% endfor %}
    """
    data = {
{% for field_name, field in entity.fields.items() %}
{% if not field.api_exclude_response | default(false) %}
{% set api_name = field.api_field_name | default(field_name) %}
{% if field.type == 'datetime' %}
        "{{ api_name }}": isoformat_utc({{ entity_lower }}.{{ field_name }}),
{% elif field.type == 'financial' %}
        "{{ api_name }}": normalize_decimal({{ entity_lower }}.{{ field_name }}),
{% elif field.type == 'percentage' %}
        "{{ api_name }}": normalize_decimal({{ entity_lower }}.{{ field_name }}),
{% elif field.type == 'uuid' %}
        "{{ api_name }}": str({{ entity_lower }}.{{ field_name }}) if {{ entity_lower }}.{{ field_name }} else None,
{% elif field.type == 'reference' %}
        "{{ api_name }}": str({{ entity_lower }}.{{ field_name }}) if {{ entity_lower }}.{{ field_name }} else None,
{% else %}
        "{{ api_name }}": {{ entity_lower }}.{{ field_name }},
{% endif %}
{% endif %}
{% endfor %}
{% if entity.timestamps.created | default(false) %}
        "created_at": isoformat_utc({{ entity_lower }}.created_at),
{% endif %}
{% if entity.timestamps.updated | default(false) %}
        "updated_at": isoformat_utc({{ entity_lower }}.updated_at),
{% endif %}
    }
    return {{ entity_name }}Response(**data)  # type: ignore[arg-type]


{% endfor %}

