{% for pv in pattern_validators %}
    @field_validator("{{ pv.name }}")
    @classmethod
    def validate_{{ pv.name }}_format(cls, v: str | None) -> str | None:
        """Validate {{ pv.name }} format."""
        if v is None:
            return v
        pattern = re.compile(r"{{ pv.regex }}")
        if not pattern.match(v):
            raise ValueError("{{ pv.message }}")
        return v

