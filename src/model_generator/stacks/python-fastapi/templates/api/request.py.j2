{% elif field.default is defined %}
{% if field.type == 'enum' %}
{% set _ = field_args.append(field.enum_name + '.' + (field.default | upper)) %}
{% elif field.type == 'boolean' %}
{% set _ = field_args.append(field.default | title) %}
{% elif field.type in ['text', 'longtext', 'financial', 'percentage', 'reference'] %}
{% set _ = field_args.append('"' + (field.default | string) + '"') %}
{% else %}
{% set _ = field_args.append(field.default | string) %}
{% endif %}
{% elif field.type == 'json_array' %}
{#- Use default_factory for list fields to avoid mutable default issues -#}
