{#- Use default_factory for dict fields to avoid mutable default issues -#}
{% set needs_default_factory = true %}
{% set _ = field_args.append('default_factory=dict') %}
{% else %}
{% set _ = field_args.append('None') %}
{% endif %}
{% if field.min_length is defined %}
{% set _ = field_args.append('min_length=' + (field.min_length | string)) %}
{% endif %}
{% if field.max_length is defined %}
{% set _ = field_args.append('max_length=' + (field.max_length | string)) %}
{% endif %}
{#- Handle description: long descriptions get noqa: E501 on their own line -#}
{% set desc_escaped = field.description | default('') | replace('\\', '\\\\') | replace('"', '\\"') %}
{% set desc_is_long = field.description is defined and field.description | length > 60 %}
{% if field.description is defined and not desc_is_long %}
{% set _ = field_args.append('description="' + desc_escaped + '"') %}
{% endif %}
{#- Determine type hint -#}
{% if field.type == 'text' or field.type == 'longtext' %}
{% set type_hint = 'str' if is_required else 'str | None' %}
{% elif field.type == 'reference' %}
{% set type_hint = 'str' if is_required else 'str | None' %}
{% elif field.type in ['financial', 'percentage'] %}
{% set type_hint = 'str' if is_required else 'str | None' %}
{% elif field.type == 'counter' %}
{% set type_hint = 'int' if is_required else 'int | None' %}
{% elif field.type == 'boolean' %}
{% set type_hint = 'bool' %}
{% elif field.type == 'binary' %}
{% set type_hint = 'bytes' %}
{% elif field.type == 'datetime' %}
{% set type_hint = 'datetime' if is_required else 'datetime | None' %}
{% elif field.type == 'enum' %}
{% set type_hint = field.enum_name if is_required else field.enum_name + ' | None' %}
{% elif field.type == 'json_object' %}
{% set type_hint = 'dict[str, Any]' %}
{% elif field.type == 'json_array' %}
{% set type_hint = 'list[' + field.list_type + ']' if field.list_type is defined else 'list[Any]' %}
{% else %}
{% set type_hint = 'str | None' %}
{% endif %}
{% if desc_is_long %}
    {{ field_name }}: {{ type_hint }} = Field(
        {{ field_args | join(', ') }},
        description="{{ desc_escaped }}",  # noqa: E501
    )
{% else %}
    {{ field_name }}: {{ type_hint }} = Field({{ field_args | join(', ') }})
{% endif %}
{% endfor %}

