{#-
  API Request Models Template (Multi-Entity)
  Generates Pydantic create and update request models for all entities in a domain
-#}
{% from "_shared/_base.j2" import generated_marker, section_divider, section_header %}
{{ generated_marker() }}

"""
{{ model.section_header | default(model.domain | upper + ' MODELS') }} - API Request Models.

{{ model.description | default('API request models for ' + model.domain + '.') | wrap(88) }}

This module contains:
{% for entity_name, entity in model.entities.items() %}
- Create{{ entity_name }}Request: Request model for creating {{ entity_name }}
{% if entity.mutability | default('mutable') != 'immutable' %}
- Update{{ entity_name }}Request: Request model for updating {{ entity_name }}
{% endif %}
