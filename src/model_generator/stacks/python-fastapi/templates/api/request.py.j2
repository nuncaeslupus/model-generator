{#- Scan all entities for required imports -#}
{% for entity_name, entity in model.entities.items() %}
{% for field_name, field in entity.fields.items() %}
{% set api_name = field.api_field_name | default(field_name) %}
{% if field.type in ['json_object', 'json_array'] %}{% set ns.has_any = true %}{% endif %}
{% if field.type == 'datetime' %}{% set ns.has_datetime = true %}{% endif %}
{% if field.type == 'enum' %}
{% if not field.api_exclude_create | default(false) or not field.api_exclude_update | default(false) %}
{% if field.enum_name not in ns.enum_imports %}{% set _ = ns.enum_imports.append(field.enum_name) %}{% endif %}
{% endif %}
{% endif %}
{#- Check for email fields that need validation -#}
{% if api_name == 'email' and not field.api_exclude_create | default(false) %}
{% if 'validate_email_format' not in ns.needs_validators %}{% set _ = ns.needs_validators.append('validate_email_format') %}{% endif %}
{% endif %}
{#- Check for username fields with length constraints -#}
{% if api_name == 'username' and not field.api_exclude_create | default(false) %}
