{% endfor %}
    """

{% for item in create_fields %}
{% set field = item.field %}
{% set field_name = item.name %}
{% set is_required = field.required | default(false) or (field.primary_key | default(false) and not field.auto_generate | default(true)) %}
{#- Build Field() arguments -#}
{% set field_args = [] %}
{#- Track if we need default_factory for list/dict fields -#}
{% set needs_default_factory = false %}
