{#-
  Field Utility Macros
  Type hint generation and field detection utilities.
-#}

{#- Check if a field is required (either explicitly or as non-auto-generated PK) -#}
{% macro is_field_required(field) -%}
{%- if field.required or (field.primary_key | default(false) and not field.auto_generate | default(true)) -%}
true
{%- endif -%}
{%- endmacro %}

{#- Generate Python type hint for a field -#}
{#- for_response: response models use | None, request models use Optional or default -#}
{% macro python_type_hint(field, field_name, for_response=false) -%}
{%- if field.type == 'uuid' -%}
str{{ ' | None' if for_response else '' }}
{%- elif field.type in ['text', 'longtext'] -%}
str{{ ' | None' if for_response else '' }}
{%- elif field.type == 'reference' -%}
str{{ ' | None' if for_response else '' }}
{%- elif field.type in ['financial', 'percentage'] -%}
str{{ ' | None' if for_response else '' }}
{%- elif field.type == 'counter' -%}
int{{ ' | None' if for_response else '' }}
{%- elif field.type == 'boolean' -%}
bool{{ ' | None' if for_response else '' }}
{%- elif field.type == 'datetime' -%}
str{{ ' | None' if for_response else '' }}
{%- elif field.type == 'enum' -%}
{{ field.enum_name }}{{ ' | None' if for_response else '' }}
{%- elif field.type == 'json_object' -%}
dict[str, Any]{{ ' | None' if for_response else '' }}
{%- elif field.type == 'json_array' -%}
list[{{ field.list_type | default('Any') }}]{{ ' | None' if for_response else '' }}
{%- else -%}
Any
{%- endif -%}
{%- endmacro %}

{#- Check if any fields need the Any type import -#}
{% macro needs_any_import(entity) -%}
{%- for field_name, field in entity.fields.items() -%}
{%- if field.type in ['json_object', 'json_array'] -%}
true
{%- endif -%}
{%- endfor -%}
{%- endmacro %}
