{#-
  Base Macros
  Common header and formatting macros used across all templates.
-#}

{#- Generated file marker - consistent warning across all templates -#}
{% macro generated_marker() -%}
# THIS CODE WAS INITIALLY GENERATED BY model-generator
{%- endmacro %}

{#- Full-width section divider (for major file sections) -#}
{% macro section_divider(title) -%}
# ============================================================================
# {{ title | upper }}
# ============================================================================
{%- endmacro %}

{#- Inline section header (for class subsections, indented) -#}
{% macro section_header(title) -%}
    # ====== {{ title }} ======
{%- endmacro %}

{#- Banner-style section (for routes/tests, centered title) -#}
{% macro section_banner(title) -%}
# ==================== {{ title | upper }} ====================
{%- endmacro %}
