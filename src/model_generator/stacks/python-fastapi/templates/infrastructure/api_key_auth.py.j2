"""
Static API-key authentication for {{ project.name | default('the application') }}.

Generated by model-generator (auth.strategy: api-key). A single shared secret
is read from the `{{ key_env }}` environment variable and compared, in constant
time, against the `{{ header_name }}` header on every protected request.

Entities opt in by setting `api.require_auth: true` in their spec; the generated
routes then depend on `require_api_key`. There is no per-user identity here —
every caller presents the same key — so this is orthogonal to `api.scope`
(owner filtering), which the session strategy provides.

Adopters typically need to:
- Set the `{{ key_env }}` environment variable to a long random secret.
- Rotate it by updating the env var (and any clients) — there is no stored
  state to migrate.
"""

from __future__ import annotations

import os
import secrets

from fastapi import Header, HTTPException, status

_KEY_ENV = "{{ key_env }}"


def _expected_api_key() -> str:
    """Return the configured shared secret, fail-closed in production.

    Mirrors the SESSION_SECRET_KEY guard in the session strategy: a missing
    key is a hard error under APP_ENV=production, and a clearly-marked dev
    fallback otherwise so local runs work without configuration.
    """
    key = os.environ.get(_KEY_ENV)
    if key:
        return key
    if os.environ.get("APP_ENV") == "production":
        raise RuntimeError(
            f"{_KEY_ENV} environment variable must be set in production."
        )
    return "DEV-ONLY-CHANGE-ME-IN-PRODUCTION"


async def require_api_key(
    {{ header_param }}: str | None = Header(default=None, alias="{{ header_name }}"),
) -> None:
    """Reject the request unless it carries a valid API key.

    Used as a route dependency (`Depends(require_api_key)`); it returns nothing
    on success and raises 401 otherwise. The comparison is constant-time to
    avoid leaking the secret through timing.
    """
    expected = _expected_api_key()
    if {{ header_param }} is None or not secrets.compare_digest({{ header_param }}, expected):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or missing API key",
        )
