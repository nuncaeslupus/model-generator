"""
Authentication router for {{ project.name | default('the application') }}.

Generated by model-generator (§12 — auth scaffolding). Bcrypt + HMAC-pepper
password hashing, itsdangerous-signed opaque-token cookies, DB-backed
sessions via the UserSession entity.

Adopters typically need to:
- Set the `{{ config.auth.pepper_env }}` environment variable (any non-empty
  string; treat it as a secret and never rotate without re-hashing).
- Set `SESSION_SECRET_KEY` (32+ random bytes; used to sign cookies and
  password-reset tokens).
- Override `_send_password_reset_email` to wire your email provider.
"""

from __future__ import annotations

import hashlib
import hmac
import logging
import os
import secrets
from datetime import datetime, timedelta, timezone
from uuid import UUID

import bcrypt
from fastapi import APIRouter, Depends, HTTPException, Request, Response, status
from itsdangerous import BadSignature, SignatureExpired, URLSafeTimedSerializer
from pydantic import BaseModel, EmailStr, Field
from sqlalchemy import select, update
from sqlalchemy.ext.asyncio import AsyncSession

from {{ db_import }}.engine import get_session
from {{ db_models_import }}.user import User
from {{ db_models_import }}.user_session import UserSession

from .csrf import clear_csrf_cookie, set_csrf_cookie
{% if rate_limit_enabled %}
from .rate_limit import FORGOT_LIMIT, LOGIN_LIMIT, REGISTER_LIMIT, limiter
{% endif %}

# ---------------------------------------------------------------------------
# Configuration
# ---------------------------------------------------------------------------

_PEPPER_ENV = "{{ config.auth.pepper_env }}"
_COOKIE_NAME = "{{ config.auth.cookie_name | default('session_id') }}"
_SESSION_TTL = timedelta(days={{ config.auth.session_ttl_days | default(7) }})
_RESET_TOKEN_TTL = timedelta(hours={{ config.auth.reset_token_ttl_hours | default(1) }})


def _resolve_session_secret() -> str:
    """Return the session-signing secret, refusing the dev default in production."""
    secret = os.environ.get("SESSION_SECRET_KEY")
    if secret:
        return secret
    if os.environ.get("APP_ENV") == "production":
        raise RuntimeError(
            "SESSION_SECRET_KEY environment variable must be set in production."
        )
    return "DEV-ONLY-CHANGE-ME-IN-PRODUCTION"


logger = logging.getLogger(__name__)

# Two independent serializers with distinct salts. Both derive from
# SESSION_SECRET_KEY, but the salt separation means a token minted to sign a
# session cookie cannot be replayed as a password-reset token (or vice versa)
# even if one context's output reaches the other (SEC-4 — defense in depth).
_session_serializer = URLSafeTimedSerializer(
    _resolve_session_secret(), salt="session-cookie"
)
_reset_serializer = URLSafeTimedSerializer(
    _resolve_session_secret(), salt="password-reset"
)


def _is_secure_cookie() -> bool:
    """Return True when running in production (drives the `Secure` cookie attr)."""
    return os.environ.get("APP_ENV") == "production"


# ---------------------------------------------------------------------------
# Password hashing (HMAC-SHA256 pepper + bcrypt)
# ---------------------------------------------------------------------------
#
# The pepper is HMAC'd with the password before bcrypt to avoid bcrypt's
# 72-byte input truncation. This is OWASP-aligned and removes a footgun
# present in the simpler `bcrypt(password + pepper)` pattern.


def _peppered(password: str) -> str:
    pepper = os.environ.get(_PEPPER_ENV)
    if not pepper:
        raise RuntimeError(
            f"{_PEPPER_ENV} environment variable is not set; "
            "password hashing requires it."
        )
    return hmac.new(pepper.encode(), password.encode(), hashlib.sha256).hexdigest()


def hash_password(password: str) -> str:
    """Hash a plaintext password (HMAC-pepper then bcrypt)."""
    return bcrypt.hashpw(_peppered(password).encode(), bcrypt.gensalt()).decode()


def verify_password(password: str, password_hash: str) -> bool:
    """Verify a plaintext password against a stored hash."""
    return bcrypt.checkpw(_peppered(password).encode(), password_hash.encode())


def _token_fingerprint(password_hash: str) -> str:
    """Short fingerprint of the current password hash.

    Bound into reset tokens so a token becomes single-use: once the password
    changes (by this reset or any other path) the fingerprint no longer matches
    and the token is rejected, closing the replay-within-TTL window.
    """
    return hashlib.sha256(password_hash.encode()).hexdigest()[:16]


# ---------------------------------------------------------------------------
# Password-reset email (adopter overrides)
# ---------------------------------------------------------------------------


async def _send_password_reset_email(email: str, token: str) -> None:
    """Send a password-reset email containing the signed token.

    Override this in your application to wire your email provider
    (SendGrid, SES, Postmark, etc.). The default implementation raises
    NotImplementedError so the gap surfaces at runtime rather than
    silently swallowing reset requests.
    """
    raise NotImplementedError(
        "Password-reset email send is not configured. "
        "Override _send_password_reset_email() in your auth router."
    )


# ---------------------------------------------------------------------------
# Pydantic schemas
# ---------------------------------------------------------------------------


class RegisterRequest(BaseModel):
    username: str = Field(min_length=3, max_length=50)
    email: EmailStr
    password: str = Field(min_length=8, max_length=255)
    first_name: str | None = Field(default=None, max_length=100)
    last_name: str | None = Field(default=None, max_length=100)


class RegisterResponse(BaseModel):
    id: UUID
    username: str
    email: str


class LoginRequest(BaseModel):
    username: str
    password: str


class LoginResponse(BaseModel):
    id: UUID
    username: str
    email: str


class MessageResponse(BaseModel):
    message: str


class ForgotPasswordRequest(BaseModel):
    email: EmailStr


class ResetPasswordRequest(BaseModel):
    token: str
    new_password: str = Field(min_length=8, max_length=255)


class ChangePasswordRequest(BaseModel):
    current_password: str
    new_password: str = Field(min_length=8, max_length=255)


# ---------------------------------------------------------------------------
# get_current_user dependency
# ---------------------------------------------------------------------------


async def get_current_user(
    request: Request,
    session: AsyncSession = Depends(get_session),
) -> User:
    """Resolve the authenticated User from the signed session cookie.

    Looks up the UserSession row by token, verifies expiry + active flag,
    returns the associated User. Raises 401 on any failure.
    """
    cookie = request.cookies.get(_COOKIE_NAME)
    if not cookie:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Not authenticated",
        )
    try:
        session_token = _session_serializer.loads(
            cookie, max_age=int(_SESSION_TTL.total_seconds())
        )
    except (BadSignature, SignatureExpired) as exc:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid or expired session",
        ) from exc

    stmt = select(UserSession).where(
        UserSession.session_token == session_token,
        UserSession.is_active.is_(True),
    )
    result = await session.execute(stmt)
    user_session = result.scalar_one_or_none()
    if user_session is None or user_session.expires_at < datetime.now(timezone.utc):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Session not found or expired",
        )

    user = await session.get(User, user_session.user_id)
    if user is None:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="User not found",
        )
    return user


# ---------------------------------------------------------------------------
# Router
# ---------------------------------------------------------------------------

router = APIRouter(tags=["auth"])


@router.post(
    "/register",
    response_model=RegisterResponse,
    status_code=status.HTTP_201_CREATED,
)
{% if rate_limit_enabled %}
@limiter.limit(REGISTER_LIMIT)
{% endif %}
async def register(
{% if rate_limit_enabled %}
    request: Request,
{% endif %}
    payload: RegisterRequest,
    session: AsyncSession = Depends(get_session),
) -> RegisterResponse:
    existing = await session.execute(
        select(User).where(
            (User.username == payload.username) | (User.email == payload.email)
        )
    )
    if existing.scalar_one_or_none() is not None:
        raise HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail="Username or email already registered",
        )

    user = User(
        username=payload.username,
        email=payload.email,
        password_hash=hash_password(payload.password),
        first_name=payload.first_name,
        last_name=payload.last_name,
    )
    session.add(user)
    await session.commit()
    await session.refresh(user)
    return RegisterResponse(id=user.id, username=user.username, email=user.email)


@router.post("/login", response_model=LoginResponse)
{% if rate_limit_enabled %}
@limiter.limit(LOGIN_LIMIT)
{% endif %}
async def login(
    request: Request,
    payload: LoginRequest,
    response: Response,
    session: AsyncSession = Depends(get_session),
) -> LoginResponse:
    stmt = select(User).where(User.username == payload.username)
    result = await session.execute(stmt)
    user = result.scalar_one_or_none()

    # Always run verify_password to keep timing consistent on user-missing.
    fallback_hash = "$2b$12$" + "A" * 53
    valid = verify_password(
        payload.password, user.password_hash if user is not None else fallback_hash
    )
    if user is None or not valid:
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Invalid credentials",
        )

    session_token = secrets.token_urlsafe(32)
    expires_at = datetime.now(timezone.utc) + _SESSION_TTL
    user_session = UserSession(
        user_id=user.id,
        session_token=session_token,
        ip_address=request.client.host if request.client else None,
        user_agent=request.headers.get("user-agent"),
        expires_at=expires_at,
        last_activity_at=datetime.now(timezone.utc),
        is_active=True,
    )
    session.add(user_session)
    user.last_login_at = datetime.now(timezone.utc)
    await session.commit()

    response.set_cookie(
        key=_COOKIE_NAME,
        value=_session_serializer.dumps(session_token),
        max_age=int(_SESSION_TTL.total_seconds()),
        httponly=True,
        samesite="lax",
        secure=_is_secure_cookie(),
    )
    set_csrf_cookie(response)
    return LoginResponse(id=user.id, username=user.username, email=user.email)


@router.post("/logout", response_model=MessageResponse)
async def logout(
    request: Request,
    response: Response,
    current_user: User = Depends(get_current_user),
    session: AsyncSession = Depends(get_session),
) -> MessageResponse:
    cookie = request.cookies.get(_COOKIE_NAME)
    if cookie:
        try:
            token = _session_serializer.loads(cookie)
            stmt = select(UserSession).where(UserSession.session_token == token)
            result = await session.execute(stmt)
            user_session = result.scalar_one_or_none()
            if user_session is not None:
                user_session.is_active = False
                await session.commit()
        except (BadSignature, SignatureExpired):
            # Cookie signature is bad — nothing to revoke server-side.
            pass
    response.delete_cookie(_COOKIE_NAME)
    clear_csrf_cookie(response)
    return MessageResponse(message="logged out")


@router.post("/forgot-password", response_model=MessageResponse)
{% if rate_limit_enabled %}
@limiter.limit(FORGOT_LIMIT)
{% endif %}
async def forgot_password(
{% if rate_limit_enabled %}
    request: Request,
{% endif %}
    payload: ForgotPasswordRequest,
    session: AsyncSession = Depends(get_session),
) -> MessageResponse:
    """Generate a signed reset token and dispatch it via email.

    Always returns the same 200 response whether or not the email is
    registered, so the endpoint can't be used to enumerate which addresses
    have accounts (SEC-5). A missing `_send_password_reset_email` hook is
    surfaced via a logged warning rather than an HTTP status — returning a
    distinct status only when the user exists would reintroduce the
    enumeration oracle this avoids.
    """
    stmt = select(User).where(User.email == payload.email)
    result = await session.execute(stmt)
    user = result.scalar_one_or_none()
    if user is not None:
        token = _reset_serializer.dumps(
            {"user_id": str(user.id), "pw": _token_fingerprint(user.password_hash)}
        )
        try:
            await _send_password_reset_email(user.email, token)
        except NotImplementedError:
            logger.warning(
                "Password-reset email send is not configured; override "
                "_send_password_reset_email() to enable it. The reset token "
                "was generated but not delivered."
            )
        except Exception:
            # Swallow *any* send failure (SMTP/network/etc.): the hook only runs
            # when the user exists, so letting an exception surface as a 500
            # would leak account existence — the exact enumeration oracle this
            # endpoint avoids. Log it for ops; the caller always gets the same 200.
            logger.exception("Failed to send password-reset email.")
    return MessageResponse(
        message="If that email is registered, a reset link has been sent."
    )


@router.post("/reset-password", response_model=MessageResponse)
async def reset_password(
    payload: ResetPasswordRequest,
    session: AsyncSession = Depends(get_session),
) -> MessageResponse:
    try:
        data = _reset_serializer.loads(
            payload.token, max_age=int(_RESET_TOKEN_TTL.total_seconds())
        )
    except (BadSignature, SignatureExpired) as exc:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid or expired reset token",
        ) from exc

    user_id = data.get("user_id") if isinstance(data, dict) else None
    if not user_id:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid reset token",
        )

    user = await session.get(User, UUID(user_id))
    if user is None:
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid reset token",
        )

    # Single-use: reject a token whose bound fingerprint no longer matches the
    # current password hash (already-used or otherwise-rotated token).
    fingerprint = data.get("pw") if isinstance(data, dict) else None
    if fingerprint != _token_fingerprint(user.password_hash):
        raise HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail="Invalid or expired reset token",
        )

    user.password_hash = hash_password(payload.new_password)
    # Revoke all existing sessions so a reset (e.g. account-takeover recovery)
    # actually evicts an attacker instead of leaving their session valid.
    await session.execute(
        update(UserSession)
        .where(UserSession.user_id == user.id)
        .values(is_active=False)
    )
    await session.commit()
    return MessageResponse(message="Password reset successful")


@router.post("/change-password", response_model=MessageResponse)
async def change_password(
    payload: ChangePasswordRequest,
    current_user: User = Depends(get_current_user),
    session: AsyncSession = Depends(get_session),
) -> MessageResponse:
    if not verify_password(payload.current_password, current_user.password_hash):
        raise HTTPException(
            status_code=status.HTTP_401_UNAUTHORIZED,
            detail="Current password is incorrect",
        )
    current_user.password_hash = hash_password(payload.new_password)
    # Revoke existing sessions on credential change (forces re-login everywhere).
    await session.execute(
        update(UserSession)
        .where(UserSession.user_id == current_user.id)
        .values(is_active=False)
    )
    await session.commit()
    return MessageResponse(message="Password changed successfully")
