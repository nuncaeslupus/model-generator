"""
Rate limiting for the auth router (slowapi).

Generated by model-generator (§12 — auth scaffolding). The Limiter()
instance is shared across login / register / forgot-password and is
exposed for the FastAPI app to register the RateLimitExceeded
exception handler.

Storage:
    Defaults to in-memory ("memory://") which is fine for single-process
    deployments. For multi-worker / multi-instance deployments switch
    `auth.rate_limit.backend: "redis"` in .model-generator.yaml and set
    the `RATELIMIT_STORAGE_URI` env var to a redis URL (e.g.
    redis://localhost:6379/0).

Customization:
    Adopters can edit the constants below or override them via
    `auth.rate_limit.{login, register, forgot}` in the generator config.

Client IP / reverse proxies:
    `get_remote_address` keys on the socket peer (`request.client.host`).
    Behind a reverse proxy or load balancer that is the *proxy's* IP, so
    every client collapses into one bucket and the limit becomes effectively
    global. If you deploy behind a trusted proxy, replace `key_func` with one
    that reads the client IP from a forwarded header (e.g. `X-Forwarded-For`)
    — but only trust that header for requests arriving from a proxy you
    control, otherwise clients can spoof it and trivially bypass the limit.
"""

import os

from slowapi import Limiter
from slowapi.util import get_remote_address

LOGIN_LIMIT = "{{ login_limit }}"
REGISTER_LIMIT = "{{ register_limit }}"
FORGOT_LIMIT = "{{ forgot_limit }}"

_storage_uri = os.environ.get("RATELIMIT_STORAGE_URI", "{{ default_storage_uri }}")

# key_func reads the socket peer IP; see "Client IP / reverse proxies" above
# before deploying behind a proxy/load balancer.
limiter = Limiter(key_func=get_remote_address, storage_uri=_storage_uri)
