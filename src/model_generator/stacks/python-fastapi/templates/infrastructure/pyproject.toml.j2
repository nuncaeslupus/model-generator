{#-
  pyproject.toml Template
  Generates project configuration for new projects created by model-generator.
  Generated once at project bootstrap; modify manually afterward.
-#}
[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

[tool.setuptools.packages.find]
where = ["{{ package_root }}"]

[project]
name = "{{ project_slug }}"
version = "{{ project.version | default('0.1.0') }}"
description = "{{ project.description | default('Generated by model-generator') }}"
readme = {text = "", content-type = "text/plain"}
requires-python = ">={{ style.python_version }}"
dependencies = [
{% for dep in runtime_deps %}
    "{{ dep }}",
{% endfor %}
]

[project.optional-dependencies]
dev = [
{% for dep in dev_deps %}
    "{{ dep }}",
{% endfor %}
]

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["."]
addopts = "--strict-markers --tb=short"
markers = [
    "contract: marks tests as contract tests (API boundary validation)",
]
asyncio_mode = "auto"

{% if style.line_length is not none %}
[tool.ruff]
line-length = {{ style.line_length }}

{% endif %}
[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "W",   # pycodestyle warnings
    "F",   # pyflakes
    "I",   # isort
    "B",   # flake8-bugbear
    "C4",  # flake8-comprehensions
    "UP",  # pyupgrade
]
ignore = [
    "E501",  # line too long, handled by formatter
    "B008",  # do not perform function calls in argument defaults
    "B904",  # raise from None
    "W191",  # indentation contains tabs
]

[tool.ruff.lint.per-file-ignores]
# Alembic's env.py configures logging before importing the model metadata, so
# its post-setup imports trip E402 (module import not at top). This is the
# standard generated alembic layout — ignore E402 for that one module so
# `ruff check .` is green out of the box.
"{{ migrations_path }}/env.py" = ["E402"]

[tool.ruff.format]
{% if style.quote_style is not none %}
quote-style = "{{ style.quote_style }}"
{% endif %}
{% if style.indent_style is not none %}
indent-style = "{{ style.indent_style }}"
{% endif %}
skip-magic-trailing-comma = false
line-ending = "auto"

[tool.mypy]
python_version = "{{ style.python_version }}"
explicit_package_bases = true
warn_return_any = true
warn_unused_configs = true
disallow_untyped_defs = true
disallow_incomplete_defs = true
check_untyped_defs = true
warn_no_return = true
warn_unused_ignores = true

[tool.mutmut]
paths_to_mutate = [
    "{{ validators_path }}",
    "{{ utils_path }}",
    "{{ constraints_path }}",
]
tests_dir = ["tests/"]
also_copy = ["{{ also_copy_dir }}"]
backup = false
