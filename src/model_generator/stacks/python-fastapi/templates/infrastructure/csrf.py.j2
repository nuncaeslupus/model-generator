"""
CSRF middleware (double-submit cookie pattern).

Generated by model-generator (§12 — auth scaffolding). Adopters can
replace this file with a different implementation (synchronizer-token,
library-based, etc.) without touching the auth router.

Frontend contract:
    The server sets a `csrf_token` cookie on login (and clears it on
    logout). The cookie is intentionally NOT HttpOnly so frontend JS
    can read it. Include the cookie's value as the `X-CSRF-Token`
    header on every POST / PUT / PATCH / DELETE request. The middleware
    compares cookie ↔ header and rejects mismatches with 403.

Exempt paths:
    Unauthenticated mutating endpoints (no session cookie to abuse) and
    token-authenticated endpoints (no cookie to attack) are listed in
    `EXEMPT_PATHS`. Edit that set if you add or rename auth routes.
"""

import os
import secrets
from collections.abc import Awaitable, Callable

from starlette.middleware.base import BaseHTTPMiddleware
from starlette.requests import Request
from starlette.responses import JSONResponse, Response

CSRF_COOKIE_NAME = "csrf_token"
CSRF_HEADER_NAME = "X-CSRF-Token"

_MUTATING_METHODS = frozenset({"POST", "PUT", "PATCH", "DELETE"})

# Paths exempt from CSRF protection. Either unauthenticated mutating
# endpoints (register / login / forgot-password) or token-authenticated
# endpoints (reset-password, which validates an itsdangerous-signed
# token from the request body, not a session cookie).
EXEMPT_PATHS: frozenset[str] = frozenset(
    {
        "/api/v1/auth/register",
        "/api/v1/auth/login",
        "/api/v1/auth/forgot-password",
        "/api/v1/auth/reset-password",
    }
)


def _is_secure_cookie() -> bool:
    return os.environ.get("APP_ENV") == "production"


def set_csrf_cookie(response: Response, token: str | None = None) -> str:
    """Mint (or refresh) the CSRF cookie on the response.

    Returns the token value so the caller can pin it to the session row
    if a synchronizer-token pattern is layered on top later.
    """
    token = token or secrets.token_urlsafe(32)
    response.set_cookie(
        key=CSRF_COOKIE_NAME,
        value=token,
        httponly=False,
        samesite="lax",
        secure=_is_secure_cookie(),
    )
    return token


def clear_csrf_cookie(response: Response) -> None:
    """Clear the CSRF cookie (paired with session logout)."""
    response.delete_cookie(CSRF_COOKIE_NAME)


class CsrfMiddleware(BaseHTTPMiddleware):
    """Reject mutating requests whose CSRF cookie ≠ X-CSRF-Token header."""

    async def dispatch(
        self,
        request: Request,
        call_next: Callable[[Request], Awaitable[Response]],
    ) -> Response:
        if (
            request.method in _MUTATING_METHODS
            and request.url.path not in EXEMPT_PATHS
        ):
            cookie_token = request.cookies.get(CSRF_COOKIE_NAME)
            header_token = request.headers.get(CSRF_HEADER_NAME)
            if (
                not cookie_token
                or not header_token
                or not secrets.compare_digest(cookie_token, header_token)
            ):
                return JSONResponse(
                    status_code=403,
                    content={"detail": "CSRF token missing or invalid"},
                )
        return await call_next(request)
