{#-
  .env.example Template
  Manifest of the environment variables the generated project reads. Copy to
  `.env` and fill in real values. Generated once at bootstrap; edit manually
  afterward.
-#}
# Environment variables for {{ project.name | default('this project') }}.
# Copy to `.env` and adjust per deployment. Commented-out variables are
# optional (their documented default applies when unset).

# Deployment environment. Set to "production" to enforce production guards
# (DATABASE_URL{% if session_auth %} and SESSION_SECRET_KEY{% elif api_key_auth %} and {{ key_env }}{% endif %} must be set; no insecure dev fallbacks).
APP_ENV=development

# Database connection URL (async driver).
#   PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/dbname
#   SQLite:     sqlite+aiosqlite:///./app.db
# Required when APP_ENV=production; falls back to local SQLite otherwise.
# Left commented so it stays unset by default: that lets the dev SQLite
# fallback work AND keeps the production guard armed (an active SQLite value
# here would silently satisfy the guard in production).
# DATABASE_URL=sqlite+aiosqlite:///./app.db

# Optional: sync database URL for Alembic migrations. Falls back to
# DATABASE_URL (coerced to a sync driver) when unset.
# ALEMBIC_DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/dbname

# Optional: set to "true" to echo SQL statements to the log.
# SQL_ECHO=false

# Optional: comma-separated CORS allowlist (defaults to http://localhost:3000).
# Never pair "*" with credentials.
# CORS_ORIGINS=http://localhost:3000
{% if session_auth %}

# --- Authentication (bcrypt-session) ---

# Secret used to sign session cookies. Required when APP_ENV=production.
SESSION_SECRET_KEY=

# Secret pepper mixed into password hashes before bcrypt. Required (any
# non-empty value; changing it invalidates all existing password hashes).
{{ pepper_env }}=
{% endif %}
{% if api_key_auth %}

# --- Authentication (api-key) ---

# Shared secret required on every protected request (sent as the API-key
# header). Required when APP_ENV=production; a clearly-marked dev fallback
# applies otherwise. Use a long random value.
{{ key_env }}=
{% endif %}
{% if rate_limit_redis %}

# Optional: Redis storage URI for the auth rate limiter (redis backend).
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
{% endif %}
{% if has_encrypted_binary %}

# Fernet key for encrypting binary fields at rest (32-byte, base64-encoded).
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
{% endif %}
