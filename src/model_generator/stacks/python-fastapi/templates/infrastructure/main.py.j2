{#-
  FastAPI Main Application Template
  Generates the application entry point with all routes registered
-#}
{% from "_shared/_base.j2" import generated_marker %}
{{ generated_marker() }}

"""
{{ project.name | default('Application') }} - FastAPI Application.

{{ project.description | default('Generated by model-generator.') }}

Run with: uvicorn {{ main_module }}:app --reload
"""

import os
from contextlib import asynccontextmanager
from collections.abc import AsyncIterator

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

{% for domain in domains %}
from {{ api_routes_import }}.{{ domain }} import router as {{ domain }}_router
{% endfor %}
{% if auth_router_import %}
from {{ auth_router_import }} import router as auth_router
{% endif %}
{% if csrf_module_import %}
from {{ csrf_module_import }} import CsrfMiddleware
{% endif %}
{% if rate_limit_module_import %}
from slowapi import _rate_limit_exceeded_handler
from slowapi.errors import RateLimitExceeded

from {{ rate_limit_module_import }} import limiter
{% endif %}
from {{ db_import }}.engine import engine


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Application lifespan: clean up database connections on shutdown."""
    yield
    await engine.dispose()


app = FastAPI(
    title="{{ project.name | default('API') }}",
    description="{{ project.description | default('Generated by model-generator') }}",
    version="{{ project.version | default('1.0.0') }}",
    lifespan=lifespan,
)

{% if rate_limit_module_import %}
# Rate limiting (slowapi) — wire the shared limiter onto app.state and
# register the 429 exception handler. Per-endpoint @limiter.limit(...)
# decorators in the auth router enforce login / register / forgot quotas.
app.state.limiter = limiter
app.add_exception_handler(RateLimitExceeded, _rate_limit_exceeded_handler)

{% endif %}
{% if csrf_module_import %}
# CSRF middleware — added BEFORE CORS so CORS remains the outermost
# middleware (last-added is outermost in Starlette) and preflight
# OPTIONS requests don't traverse CSRF first.
app.add_middleware(CsrfMiddleware)

{% endif %}
# CORS middleware.
#
# Set CORS_ORIGINS to a comma-separated allowlist per deployment, e.g.
#   CORS_ORIGINS="https://app.example.com,https://admin.example.com"
# The default is a localhost dev origin; never ship a wildcard to production.
#
# Credentials are gated on the absence of a wildcard on purpose: pairing a
# wildcard origin with credentials makes Starlette reflect the caller's Origin
# and echo an Access-Control-Allow-Credentials header — the textbook CORS hole.
# Credentials therefore stay off unless an explicit allowlist is configured.
cors_origins = [
    origin.strip()
    for origin in os.getenv("CORS_ORIGINS", "http://localhost:3000").split(",")
    if origin.strip()
]
app.add_middleware(
    CORSMiddleware,
    allow_origins=cors_origins,
    allow_credentials="*" not in cors_origins,
    # Narrowed to the methods the generated routes serve. FastAPI answers
    # HEAD on every GET route, so HEAD is included to keep preflight happy.
    allow_methods=["GET", "POST", "PUT", "DELETE", "OPTIONS", "HEAD"],
    # Narrowed to the headers the generated routes need; add others (e.g.
    # "Authorization") if you layer on token auth.
    allow_headers=[
        "Content-Type",
        {% if csrf_module_import %}
        "X-CSRF-Token",
        {% endif %}
    ],
)


# Health check endpoint
@app.get("/health")
def health_check() -> dict[str, str]:
    """Health check endpoint."""
    return {"status": "healthy"}


# Register routers
{% if auth_router_import %}
app.include_router(auth_router, prefix="/api/v1/auth", tags=["auth"])
{% endif %}
{% for domain in domains %}
app.include_router({{ domain }}_router, prefix="/api/v1", tags=["{{ domain }}"])
{% endfor %}
