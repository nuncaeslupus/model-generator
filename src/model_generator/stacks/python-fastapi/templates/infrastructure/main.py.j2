{#-
  FastAPI Main Application Template
  Generates the application entry point with all routes registered
-#}
{% from "_shared/_base.j2" import generated_marker %}
{{ generated_marker() }}

"""
{{ project.name | default('Application') }} - FastAPI Application.

{{ project.description | default('Generated by model-generator.') }}

Run with: uvicorn {{ main_module }}:app --reload
"""

import os
from contextlib import asynccontextmanager
from collections.abc import AsyncIterator

from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

{% for domain in domains %}
from {{ api_routes_import }}.{{ domain }} import router as {{ domain }}_router
{% endfor %}
from {{ db_import }}.engine import engine


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    """Application lifespan: clean up database connections on shutdown."""
    yield
    await engine.dispose()


app = FastAPI(
    title="{{ project.name | default('API') }}",
    description="{{ project.description | default('Generated by model-generator') }}",
    version="{{ project.version | default('1.0.0') }}",
    lifespan=lifespan,
)

# CORS middleware - set CORS_ORIGINS env var for production (comma-separated)
cors_origins = os.getenv("CORS_ORIGINS", "*").split(",")
app.add_middleware(
    CORSMiddleware,
    allow_origins=cors_origins,
    allow_credentials=True,
    allow_methods=["*"],
    allow_headers=["*"],
)


# Health check endpoint
@app.get("/health")
def health_check() -> dict[str, str]:
    """Health check endpoint."""
    return {"status": "healthy"}


# Register routers
{% for domain in domains %}
app.include_router({{ domain }}_router, prefix="/api/v1", tags=["{{ domain }}"])
{% endfor %}
