"""
API error formatting utilities.

Provides consistent error response formatting for:
- Database integrity errors (unique constraints, foreign keys)
- Not found errors
"""

from fastapi import HTTPException, status
from sqlalchemy.exc import IntegrityError


def format_integrity_error(error: IntegrityError, entity_name: str = "Record") -> HTTPException:
    """
    Format SQLAlchemy IntegrityError as HTTPException.

    Args:
        error: The IntegrityError from SQLAlchemy
        entity_name: Name of the entity for the error message

    Returns:
        HTTPException with appropriate status code and detail
    """
    error_str = str(error.orig) if error.orig else str(error)

    # Check for unique constraint violation
    if "UNIQUE constraint failed" in error_str or "duplicate key" in error_str.lower():
        # Extract field name if possible
        if "UNIQUE constraint failed:" in error_str:
            field = error_str.split("UNIQUE constraint failed:")[-1].strip()
            message = f"A {entity_name} with this {field} already exists"
        else:
            message = f"A {entity_name} with these values already exists"
        return HTTPException(
            status_code=status.HTTP_409_CONFLICT,
            detail={"error": "duplicate_value", "message": message},
        )

    # Check for foreign key violation
    if "FOREIGN KEY constraint failed" in error_str or "foreign key" in error_str.lower():
        return HTTPException(
            status_code=status.HTTP_400_BAD_REQUEST,
            detail={"error": "invalid_reference", "message": "Referenced record does not exist"},
        )

    # Generic integrity error
    return HTTPException(
        status_code=status.HTTP_400_BAD_REQUEST,
        detail={"error": "integrity_error", "message": "Database constraint violation"},
    )


def format_not_found_error(entity_name: str, entity_id: object) -> HTTPException:
    """
    Format a not found error as HTTPException.

    Args:
        entity_name: Name of the entity type (e.g., "User", "Order")
        entity_id: ID that was not found

    Returns:
        HTTPException with 404 status code
    """
    return HTTPException(
        status_code=status.HTTP_404_NOT_FOUND,
        detail={"error": "not_found", "message": f"{entity_name} with id '{entity_id}' not found"},
    )
