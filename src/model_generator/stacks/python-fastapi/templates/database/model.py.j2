"""
{{ model.section_header | default(model.domain | upper + ' MODELS') }} - Database Models.

{{ model.description | default('Database models for ' + model.domain + '.') | safe_docstring | wrap(88) }}

This module contains:
{% for entity_name, entity in model.entities.items() %}
- {{ entity_name }}: {{ entity.description | default(entity_name + ' entity') | safe_docstring | truncate(60, true) }}
{% endfor %}
"""
{% set ns = namespace(
    has_integer=false,
    has_numeric=false,
    has_text=false,
    has_boolean=false,
    has_binary=false,
    has_encrypted_binary=false,
    has_datetime=false,
    has_enum=false,
    has_json=false,
    has_fk=false,
    has_fk_constraint=false,
    has_index=false,
    has_check=false,
    has_unique=false,
    has_relationships=false,
    has_uuid=false,
    has_decimal=false,
    enum_imports=[],
    constraint_imports=[],
    rel_targets=[]
) %}
{#- Scan all entities for required imports -#}
{% for entity_name, entity in model.entities.items() %}
{% for field_name, field in entity.fields.items() %}
{% if field.type == 'uuid' %}{% set ns.has_uuid = true %}{% endif %}
{% if field.type == 'counter' %}{% set ns.has_integer = true %}{% endif %}
{% if field.type in ['financial', 'percentage'] %}{% set ns.has_numeric = true %}{% set ns.has_decimal = true %}{% endif %}
{% if field.type == 'longtext' %}{% set ns.has_text = true %}{% endif %}
{% if field.type == 'boolean' %}{% set ns.has_boolean = true %}{% endif %}
{% if field.type == 'binary' %}{% set ns.has_binary = true %}{% endif %}
{% if field.type == 'binary' and field.encrypt is defined %}{% set ns.has_encrypted_binary = true %}{% endif %}
{% if field.type == 'datetime' %}{% set ns.has_datetime = true %}{% endif %}
{% if field.type == 'enum' %}{% set ns.has_enum = true %}{% if field.enum_name not in ns.enum_imports %}{% set _ = ns.enum_imports.append(field.enum_name) %}{% endif %}{% endif %}
{% if field.type in ['json_object', 'json_array'] %}{% set ns.has_json = true %}{% endif %}
{% if field.type == 'reference' %}{% set ns.has_fk = true %}{% endif %}
{% if field.constraints is defined %}
{% for constraint in field.constraints %}
{% if constraint.min_ref is defined and constraint.min_ref not in ns.constraint_imports %}{% set _ = ns.constraint_imports.append(constraint.min_ref) %}{% endif %}
{% if constraint.max_ref is defined and constraint.max_ref not in ns.constraint_imports %}{% set _ = ns.constraint_imports.append(constraint.max_ref) %}{% endif %}
{% if constraint.regex_ref is defined and constraint.regex_ref not in ns.constraint_imports %}{% set _ = ns.constraint_imports.append(constraint.regex_ref) %}{% endif %}
{% endfor %}
{% set ns.has_check = true %}
{% endif %}
{% endfor %}
{% if entity.timestamps is defined and (entity.timestamps.created or entity.timestamps.updated) %}{% set ns.has_datetime = true %}{% endif %}
{% if entity.relationships is defined and entity.relationships | length > 0 %}{% set ns.has_relationships = true %}{% endif %}
{% for rel_name, rel in entity.relationships | default({}) | dictsort %}
{% if rel.target in sibling_entities and rel.target != entity_name and rel.target not in ns.rel_targets %}{% set _ = ns.rel_targets.append(rel.target) %}{% endif %}
{% endfor %}
{% if entity.indexes is defined and entity.indexes | length > 0 %}{% set ns.has_index = true %}{% endif %}
{% if entity.foreign_keys is defined and entity.foreign_keys | length > 0 %}{% set ns.has_fk_constraint = true %}{% endif %}
{% for idx in entity.indexes | default([]) %}{% if idx.unique | default(false) %}{% set ns.has_unique = true %}{% endif %}{% endfor %}
{% for tc in entity.constraints | default([]) %}{% if tc.type == 'unique' %}{% set ns.has_unique = true %}{% elif tc.type in ['check', 'depends'] %}{% set ns.has_check = true %}{% endif %}{% endfor %}
{% endfor %}

