class {{ entity_name }}(Base):
    """
    {{ entity.description | default(entity_name + ' entity.') | safe_docstring | wrap(88, 4, "    ") }}

    Attributes:
{% for field_name, field in entity.fields.items() %}
        {{ field_name }}: {{ field.description | default(field_name | replace('_', ' ') | capitalize + '.') | safe_docstring | wrap(88, 12, "        " + field_name + ": ") }}
{% endfor %}
{% if entity.timestamps is defined and entity.timestamps.created %}
        created_at: Timestamp when the record was created.
{% endif %}
{% if entity.timestamps is defined and entity.timestamps.updated %}
        updated_at: Timestamp when the record was last updated.
{% endif %}
    """

    __tablename__ = "{{ entity.table }}"

{% set pk_fields = entity.fields | dict2items | selectattr('value.primary_key', 'defined') | selectattr('value.primary_key', 'equalto', true) | list %}
{% if pk_fields %}
{{ section_header('Primary Key') }}
{% for item in pk_fields %}
{% if item.value.type == 'text' %}
    {{ item.key }}: Mapped[str] = mapped_column(String({{ item.value.max_length | default(255) }}), primary_key=True)
{% elif item.value.auto_generate | default(true) %}
    {{ item.key }}: Mapped[uuid.UUID] = mapped_column(PortableUuid, primary_key=True, default=uuid.uuid4)
{% else %}
    {{ item.key }}: Mapped[uuid.UUID] = mapped_column(PortableUuid, primary_key=True)
{% endif %}
{% endfor %}

{% endif %}
{% set fk_fields = entity.fields | dict2items | selectattr('value.type', 'equalto', 'reference') | list %}
{% if fk_fields %}
{{ section_header('Foreign Keys') }}
{% for item in fk_fields %}
{% set ref_col = item.value.reference_column | default('id') %}
{% set fk_type = 'PortableUuid' if ref_col == 'id' else 'String' %}
{% set py_type = 'uuid.UUID' if ref_col == 'id' else 'str' %}
{% set optional = '' if (item.value.required | default(false)) else ' | None' %}
    {{ item.key }}: Mapped[{{ py_type }}{{ optional }}] = mapped_column(
        {{ fk_type }},
        ForeignKey("{{ item.value.reference_table }}.{{ ref_col }}", ondelete="{{ item.value.on_delete | default('CASCADE') }}"),
{% if item.value.unique | default(false) %}
        unique=True,
{% endif %}
    )
{% endfor %}

{% endif %}
{% set regular_fields = entity.fields | dict2items | rejectattr('value.primary_key', 'defined') | rejectattr('value.type', 'equalto', 'reference') | list %}
{% set regular_fields = regular_fields | rejectattr('value.primary_key', 'equalto', true) | list %}
{% if regular_fields %}
{{ section_header('Core Fields') }}
{% for item in regular_fields %}
{% set field = item.value %}
{% set field_name = item.key %}
{#- A field with a default (explicit, or the implicit False the boolean branch
    always emits) is never NULL at rest, so it must not be typed Optional. An
    explicit `default: null` is the exception: it is defined yet keeps the field
    nullable, so guard with `is not none` (a bare `is defined` would catch it). -#}
{% set explicit_null = field.default is defined and field.default is none %}
{% set has_explicit_default = field.default is defined and field.default is not none %}
{% set has_default = has_explicit_default or (field.type == 'boolean' and not explicit_null) %}
{% set optional = '' if (field.required | default(false) or has_default) else ' | None' %}
{% if field.type == 'text' %}
    {{ field_name }}: Mapped[str{{ optional }}] = mapped_column(String({{ field.max_length }}){% if field.unique | default(false) %}, unique=True{% endif %}{% if has_explicit_default %}, default="{{ field.default }}"{% endif %})
{% elif field.type == 'longtext' %}
    {{ field_name }}: Mapped[str{{ optional }}] = mapped_column(Text)
{% elif field.type == 'uuid' %}
    {{ field_name }}: Mapped[uuid.UUID{{ optional }}] = mapped_column(PortableUuid{% if field.unique | default(false) %}, unique=True{% endif %})
{% elif field.type == 'counter' %}
    {{ field_name }}: Mapped[int{{ optional }}] = mapped_column(Integer{% if has_explicit_default %}, default={{ field.default }}{% endif %})
{% elif field.type == 'financial' %}
    {{ field_name }}: Mapped[Decimal{{ optional }}] = mapped_column(SqliteNumeric({{ field.precision | default(28) }}, {{ field.scale | default(18) }}){% if has_explicit_default %}, default=Decimal("{{ field.default }}"){% endif %})
{% elif field.type == 'percentage' %}
    {{ field_name }}: Mapped[Decimal{{ optional }}] = mapped_column(SqliteNumeric(5, 4){% if has_explicit_default %}, default=Decimal("{{ field.default }}"){% endif %})
{% elif field.type == 'boolean' %}
    {{ field_name }}: Mapped[bool{{ optional }}] = mapped_column(Boolean, default={{ field.default | default(false) | title }})
{% elif field.type == 'binary' %}
{% if field.encrypt is defined %}
    {{ field_name }}: Mapped[bytes{{ optional }}] = mapped_column(EncryptedBytes)
{% else %}
    {{ field_name }}: Mapped[bytes{{ optional }}] = mapped_column(LargeBinary)
{% endif %}
{% elif field.type == 'datetime' %}
{% if field.server_default is defined %}
    {{ field_name }}: Mapped[datetime{{ optional }}] = mapped_column(DateTime(timezone=True), server_default=func.now())
{% else %}
    {{ field_name }}: Mapped[datetime{{ optional }}] = mapped_column(DateTime(timezone=True))
{% endif %}
{% elif field.type == 'enum' %}
    {{ field_name }}: Mapped[{{ field.enum_name }}{{ optional }}] = mapped_column(
        SQLEnum({{ field.enum_name }}, native_enum=False),
{% if has_explicit_default %}
        default={{ field.enum_name }}.{{ field.default | upper }},
{% endif %}
    )
{% elif field.type == 'json_object' %}
{% if has_explicit_default %}
    {{ field_name }}: Mapped[dict[str, Any]{{ optional }}] = mapped_column(JSON, default=lambda: {{ field.default }})
{% else %}
    {{ field_name }}: Mapped[dict[str, Any]{{ optional }}] = mapped_column(JSON)
{% endif %}
{% elif field.type == 'json_array' %}
{% if has_explicit_default %}
    {{ field_name }}: Mapped[list[Any]{{ optional }}] = mapped_column(JSON, default=lambda: {{ field.default }})
{% else %}
    {{ field_name }}: Mapped[list[Any]{{ optional }}] = mapped_column(JSON)
{% endif %}
{% endif %}
{% endfor %}

{% endif %}
{% if entity.timestamps is defined and (entity.timestamps.created or entity.timestamps.updated) %}
{{ section_header('Timestamps') }}
{% if entity.timestamps.created %}
    created_at: Mapped[datetime] = mapped_column(DateTime(timezone=True), server_default=func.now())
{% endif %}
{% if entity.timestamps.updated %}
    updated_at: Mapped[datetime] = mapped_column(
        DateTime(timezone=True),
        server_default=func.now(),
        onupdate=func.now(),
    )
{% endif %}

{% endif %}
{% if entity.relationships is defined and entity.relationships | length > 0 %}
{{ section_header('Relationships') }}
{% for rel_name, rel in entity.relationships.items() %}
{#- Only annotate with Mapped[...] when the target lives in the same module
    (a sibling entity): the forward-ref name must resolve for mypy. Cross-file
    (cross-domain) targets aren't importable here, so they stay unannotated. -#}
{% set typed = rel.target in sibling_entities %}
{% if rel.type == 'one_to_many' %}
{% if rel.cascade is defined %}
    {{ rel_name }}{% if typed %}: Mapped[list["{{ rel.target }}"]]{% endif %} = relationship(
        "{{ rel.target }}",
{% if rel.foreign_keys is defined %}
        foreign_keys="[{% for fk in rel.foreign_keys %}{{ rel.target }}.{{ fk }}{% if not loop.last %}, {% endif %}{% endfor %}]",
{% endif %}
        back_populates="{{ rel.back_populates }}",
        cascade="{{ rel.cascade }}",
    )
{% else %}
    {{ rel_name }}{% if typed %}: Mapped[list["{{ rel.target }}"]]{% endif %} = relationship("{{ rel.target }}"{% if rel.foreign_keys is defined %}, foreign_keys="[{% for fk in rel.foreign_keys %}{{ rel.target }}.{{ fk }}{% if not loop.last %}, {% endif %}{% endfor %}]"{% endif %}, back_populates="{{ rel.back_populates }}")
{% endif %}
{% elif rel.type == 'many_to_one' %}
{% set self_ref_pks = (pk_fields | map(attribute='key') | list) if (rel.target == entity_name and pk_fields) else [] %}
{% if rel.foreign_keys is defined %}
    {{ rel_name }}{% if typed %}: Mapped["{{ rel.target }} | None"]{% endif %} = relationship("{{ rel.target }}", foreign_keys=[{{ rel.foreign_keys | join(', ') }}], back_populates="{{ rel.back_populates }}"{% if self_ref_pks %}, remote_side=[{{ self_ref_pks | join(', ') }}]{% endif %})
{% else %}
    {{ rel_name }}{% if typed %}: Mapped["{{ rel.target }} | None"]{% endif %} = relationship("{{ rel.target }}", back_populates="{{ rel.back_populates }}"{% if self_ref_pks %}, remote_side=[{{ self_ref_pks | join(', ') }}]{% endif %})
{% endif %}
{% elif rel.type == 'one_to_one' %}
    {{ rel_name }}{% if typed %}: Mapped["{{ rel.target }} | None"]{% endif %} = relationship(
        "{{ rel.target }}",
        back_populates="{{ rel.back_populates }}",
        uselist=False,
{% if rel.cascade is defined %}
        cascade="{{ rel.cascade }}",
{% endif %}
    )
{% elif rel.type == 'one_to_one_inverse' %}
    {{ rel_name }}{% if typed %}: Mapped["{{ rel.target }} | None"]{% endif %} = relationship("{{ rel.target }}", back_populates="{{ rel.back_populates }}")
{% endif %}
{% endfor %}

{% endif %}
{% set has_table_args = (entity.constraints | default([]) | length > 0) or (entity.indexes | default([]) | length > 0) or (entity.foreign_keys | default([]) | length > 0) %}
{% set field_constraints = [] %}
{% for field_name, field in entity.fields.items() %}
{% if field.constraints is defined %}
{% for c in field.constraints %}
{% set _ = field_constraints.append({'field': field_name, 'constraint': c, 'field_type': field.type}) %}
{% endfor %}
{% endif %}
{% endfor %}
{% if has_table_args or field_constraints %}
    __table_args__ = (
{% for idx in entity.indexes | default([]) %}
{% if idx.unique | default(false) %}
        UniqueConstraint({{ idx.fields | map('tojson') | join(', ') }}, name="uq_{{ entity.table }}_{{ idx.fields | join('_') }}"),
{% else %}
        Index("ix_{{ entity.table }}_{{ idx.fields | join('_') }}", {{ idx.fields | map('tojson') | join(', ') }}),
{% endif %}
{% endfor %}
{% for fc in field_constraints %}
{% set col = fc.field if fc.field_type in ['counter', 'integer'] else 'CAST(' ~ fc.field ~ ' AS NUMERIC)' %}
{% if fc.constraint.type == 'non_negative' %}
        CheckConstraint("{{ col }} >= 0", name="ck_{{ entity.table }}_{{ fc.field }}_non_negative"),
{% elif fc.constraint.type == 'positive' %}
        CheckConstraint("{{ col }} > 0", name="ck_{{ entity.table }}_{{ fc.field }}_positive"),
{% elif fc.constraint.type == 'positive_or_null' %}
        CheckConstraint("{{ col }} > 0 OR {{ fc.field }} IS NULL", name="ck_{{ entity.table }}_{{ fc.field }}_positive_or_null"),
{% elif fc.constraint.type == 'non_negative_or_null' %}
        CheckConstraint("{{ col }} >= 0 OR {{ fc.field }} IS NULL", name="ck_{{ entity.table }}_{{ fc.field }}_non_negative_or_null"),
{% elif fc.constraint.type == 'range' %}
{% set min_val = fc.constraint.min_ref | default(fc.constraint.min) %}
{% set max_val = fc.constraint.max_ref | default(fc.constraint.max) %}
        CheckConstraint(
{% if min_val is defined and max_val is defined %}
            f"{{ col }} >= {{ '{' }}{{ min_val }}{{ '}' }} AND {{ col }} <= {{ '{' }}{{ max_val }}{{ '}' }}",
{% elif min_val is defined %}
            f"{{ col }} >= {{ '{' }}{{ min_val }}{{ '}' }}",
{% else %}
            f"{{ col }} <= {{ '{' }}{{ max_val }}{{ '}' }}",
{% endif %}
            name="ck_{{ entity.table }}_{{ fc.field }}_range",
        ),
{% elif fc.constraint.type == 'range_or_null' %}
{% set min_val = fc.constraint.min_ref | default(fc.constraint.min) %}
{% set max_val = fc.constraint.max_ref | default(fc.constraint.max) %}
        CheckConstraint(
{% if min_val is defined and max_val is defined %}
            f"{{ col }} >= {{ '{' }}{{ min_val }}{{ '}' }} AND {{ col }} <= {{ '{' }}{{ max_val }}{{ '}' }} OR {{ fc.field }} IS NULL",
{% elif min_val is defined %}
            f"{{ col }} >= {{ '{' }}{{ min_val }}{{ '}' }} OR {{ fc.field }} IS NULL",
{% else %}
            f"{{ col }} <= {{ '{' }}{{ max_val }}{{ '}' }} OR {{ fc.field }} IS NULL",
{% endif %}
            name="ck_{{ entity.table }}_{{ fc.field }}_range_or_null",
        ),
{% elif fc.constraint.type == 'length' %}
{% set min_val = fc.constraint.min_ref | default(fc.constraint.min) %}
{% if fc.constraint.min_ref is defined %}
        CheckConstraint(
            f"length({{ fc.field }}) >= {{ '{' }}{{ min_val }}{{ '}' }}",
            name="ck_{{ fc.constraint.name | default(entity.table + '_' + fc.field + '_length') }}",
        ),
{% else %}
        CheckConstraint(
            "length({{ fc.field }}) >= {{ min_val }}",
            name="ck_{{ fc.constraint.name | default(entity.table + '_' + fc.field + '_length') }}",
        ),
{% endif %}
{% endif %}
{% endfor %}
{% for cfc in entity.cross_field_constraints | default([]) %}
{% if cfc.type == 'sum_equals' %}
        CheckConstraint(
            "{% for field in cfc.fields %}{{ ncol(field, entity) }}{% if not loop.last %} + {% endif %}{% endfor %} = {% if cfc.target_field %}{{ ncol(cfc.target_field, entity) }}{% else %}{{ cfc.target_value }}{% endif %}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'product_equals' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} * {{ ncol(cfc.fields[1], entity) }} = {% if cfc.target_field %}{{ ncol(cfc.target_field, entity) }}{% else %}{{ cfc.target_value }}{% endif %}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'difference_equals' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} - {{ ncol(cfc.fields[1], entity) }} = {% if cfc.target_field %}{{ ncol(cfc.target_field, entity) }}{% else %}{{ cfc.target_value }}{% endif %}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'quotient_equals' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} / {{ ncol(cfc.fields[1], entity) }} = {% if cfc.target_field %}{{ ncol(cfc.target_field, entity) }}{% else %}{{ cfc.target_value }}{% endif %}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'modulo_equals' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} % {{ ncol(cfc.fields[1], entity) }} = {% if cfc.target_field %}{{ ncol(cfc.target_field, entity) }}{% else %}{{ cfc.target_value }}{% endif %}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'field_equal' %}
        CheckConstraint(
            "{{ cfc.fields[0] }} = {{ cfc.fields[1] }}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'field_not_equal' %}
        CheckConstraint(
            "{{ cfc.fields[0] }} != {{ cfc.fields[1] }}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'field_less_than' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} < {{ ncol(cfc.fields[1], entity) }}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'field_less_than_or_equal' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} <= {{ ncol(cfc.fields[1], entity) }}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'field_greater_than' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} > {{ ncol(cfc.fields[1], entity) }}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% elif cfc.type == 'field_greater_than_or_equal' %}
        CheckConstraint(
            "{{ ncol(cfc.fields[0], entity) }} >= {{ ncol(cfc.fields[1], entity) }}",
            name="ck_{{ entity.table }}_{{ cfc.name }}",
        ),
{% endif %}
{% endfor %}
{% for tc in entity.constraints | default([]) %}
{% if tc.type == 'depends' %}
        CheckConstraint(
            "{{ tc.field }} {{ tc.operator }} {{ tc.other_field }}",
            name="ck_{{ entity.table }}_{{ tc.field }}_{{ tc.other_field }}",
        ),
{% elif tc.type == 'check' %}
        CheckConstraint("{{ tc.expression }}", name="{{ tc.name }}"),
{% elif tc.type == 'unique' %}
        UniqueConstraint({{ tc.fields | map('tojson') | join(', ') }}, name="uq_{{ entity.table }}_{{ tc.fields | join('_') }}"),
{% endif %}
{% endfor %}
{% for fk in entity.foreign_keys | default([]) %}
        ForeignKeyConstraint(
            [{{ fk.fields | map('tojson') | join(', ') }}],
            [{% for col in fk.references_columns %}"{{ fk.references_table }}.{{ col }}"{% if not loop.last %}, {% endif %}{% endfor %}],
            ondelete="{{ fk.on_delete | default('CASCADE') }}",
        ),
{% endfor %}
    )
{% endif %}
{% endfor %}
