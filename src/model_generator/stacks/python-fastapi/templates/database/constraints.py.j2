def check_positive(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for positive values (> 0).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_positive("price")
        'CAST(price AS NUMERIC) > 0'
    """
    return f"CAST({field_name} AS NUMERIC) > 0"


def check_non_negative(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for non-negative values (>= 0).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_non_negative("balance")
        'CAST(balance AS NUMERIC) >= 0'
    """
    return f"CAST({field_name} AS NUMERIC) >= 0"


def check_positive_or_null(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for positive values or NULL (> 0 OR NULL).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_positive_or_null("max_price")
        'CAST(max_price AS NUMERIC) > 0 OR max_price IS NULL'
    """
    return f"CAST({field_name} AS NUMERIC) > 0 OR {field_name} IS NULL"


def check_non_negative_or_null(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for non-negative values or NULL (>= 0 OR NULL).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_non_negative_or_null("fee")
        'CAST(fee AS NUMERIC) >= 0 OR fee IS NULL'
    """
    return f"CAST({field_name} AS NUMERIC) >= 0 OR {field_name} IS NULL"


def check_negative(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for negative values (< 0).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_negative("loss_amount")
        'CAST(loss_amount AS NUMERIC) < 0'
    """
    return f"CAST({field_name} AS NUMERIC) < 0"


def check_negative_or_null(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for negative values or NULL (< 0 OR NULL).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_negative_or_null("pnl")
        'CAST(pnl AS NUMERIC) < 0 OR pnl IS NULL'
    """
    return f"CAST({field_name} AS NUMERIC) < 0 OR {field_name} IS NULL"


def check_non_positive(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for non-positive values (<= 0).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_non_positive("credit_balance")
        'CAST(credit_balance AS NUMERIC) <= 0'
    """
    return f"CAST({field_name} AS NUMERIC) <= 0"


def check_non_positive_or_null(field_name: str) -> str:
    """
    Generate SQL CHECK constraint for non-positive values or NULL (<= 0 OR NULL).

    Args:
        field_name: Name of the database column

    Returns:
        SQL constraint string

    Example:
        >>> check_non_positive_or_null("discount")
        'CAST(discount AS NUMERIC) <= 0 OR discount IS NULL'
    """
    return f"CAST({field_name} AS NUMERIC) <= 0 OR {field_name} IS NULL"


def check_range(
    field_name: str,
    min_val: Decimal,
    max_val: Decimal,
    allow_null: bool = False,
) -> str:
    """
    Generate SQL CHECK constraint for range validation.

    Args:
        field_name: Name of the database column
        min_val: Minimum allowed value (inclusive)
        max_val: Maximum allowed value (inclusive)
        allow_null: Whether to allow NULL values

    Returns:
        SQL constraint string

    Example:
        >>> check_range("percentage", Decimal("0"), Decimal("1"))
        'CAST(percentage AS NUMERIC) >= 0 AND CAST(percentage AS NUMERIC) <= 1'
        >>> check_range("score", Decimal("1"), Decimal("10"), allow_null=True)
        'CAST(score AS NUMERIC) >= 1 AND CAST(score AS NUMERIC) <= 10 OR score IS NULL'
    """
    constraint = (
        f"CAST({field_name} AS NUMERIC) >= {min_val} "
        f"AND CAST({field_name} AS NUMERIC) <= {max_val}"
    )
    if allow_null:
        constraint += f" OR {field_name} IS NULL"
    return constraint


def check_percentage(field_name: str, allow_null: bool = False) -> str:
    """
    Generate SQL CHECK constraint for percentage values (0.0 to 1.0).

    Args:
        field_name: Name of the database column
        allow_null: Whether to allow NULL values

    Returns:
        SQL constraint string

    Example:
        >>> check_percentage("win_rate")
        'CAST(win_rate AS NUMERIC) >= 0 AND CAST(win_rate AS NUMERIC) <= 1'
        >>> check_percentage("dd", allow_null=True)
        'CAST(dd AS NUMERIC) >= 0 AND CAST(dd AS NUMERIC) <= 1 OR dd IS NULL'
    """
    return check_range(field_name, Decimal("0"), Decimal("1"), allow_null)


def check_datetime_order(
    start_field: str, end_field: str, allow_equal: bool = True
) -> str:
    """
    Generate SQL CHECK constraint to ensure end datetime is after start datetime.

    Args:
        start_field: Name of the start datetime column
        end_field: Name of the end datetime column
        allow_equal: Whether start and end can be equal (default: True)

    Returns:
        SQL constraint string

    Example:
        >>> check_datetime_order("start_date", "end_date")
        'end_date >= start_date'
        >>> check_datetime_order("open_time", "close_time", allow_equal=False)
        'close_time > open_time'
    """
    operator = ">=" if allow_equal else ">"
    return f"{end_field} {operator} {start_field}"


def check_greater_than_field(
    field_name: str, reference_field: str, allow_equal: bool = False
) -> str:
    """
    Generate SQL CHECK constraint ensuring one field is greater than another.

    Args:
        field_name: Name of the field that should be greater
        reference_field: Name of the field to compare against
        allow_equal: Whether values can be equal (default: False)

    Returns:
        SQL constraint string

    Example:
        >>> check_greater_than_field("high", "low")
        'CAST(high AS NUMERIC) > CAST(low AS NUMERIC)'
        >>> check_greater_than_field("max_price", "min_price", allow_equal=True)
        'CAST(max_price AS NUMERIC) >= CAST(min_price AS NUMERIC)'
    """
    operator = ">=" if allow_equal else ">"
    return f"CAST({field_name} AS NUMERIC) {operator} CAST({reference_field} AS NUMERIC)"


