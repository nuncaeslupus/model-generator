"""
Shared validation constraints for database and API models.

This module serves as the SINGLE SOURCE OF TRUTH for all numeric constraints,
business rules, and validation ranges used across database models and API validators.

When a constraint needs to change, update it here and it will apply to both:
- Database CHECK constraints (backend/src/models/{domain}.py)
- API Pydantic validators (backend/src/api/models/requests.py)

Organization:
- Constants are grouped by constraint type (percentages, prices, etc.)
- Documented with business meaning and units
- Use Decimal for precise financial calculations
"""

from decimal import Decimal

