{#-
  Constraints Template
  Generates constraint constants for database and API validation.

  Modes:
  - create: Generate complete file with header, docstring, and imports
  - append: Generate only new constants to append to existing file
-#}
{% from "_shared/_base.j2" import generated_marker, section_divider %}
{% if mode == 'create' %}
{{ generated_marker() }}

"""
Shared validation constraints for database and API models.

This module serves as the SINGLE SOURCE OF TRUTH for all numeric constraints,
business rules, and validation ranges used across database models and API validators.

When a constraint needs to change, update it here and it will apply to both:
- Database CHECK constraints (backend/src/models/{domain}.py)
- API Pydantic validators (backend/src/api/models/requests.py)

Organization:
- Constants are grouped by constraint type (percentages, prices, etc.)
- Documented with business meaning and units
- Use Decimal for precise financial calculations
"""

from decimal import Decimal

{% endif %}
{% if section_header %}
{{ section_divider(section_header) }}

{% endif %}
{% for constraint in constraints %}
{% if constraint.type == 'length' %}
# {{ constraint.description | default('Minimum length for ' + constraint.field) }}
{{ constraint.name }} = {{ constraint.value | default(3) }}

{% elif constraint.type == 'pattern' %}
# {{ constraint.description | default('Regex pattern for ' + constraint.field) }}
{{ constraint.name }} = r"{{ constraint.value | default('^.*$') }}"

{% elif constraint.type == 'decimal' %}
# {{ constraint.description | default('Value for ' + constraint.field) }}
{{ constraint.name }} = Decimal("{{ constraint.value | default('0') }}")

{% elif constraint.type == 'non_negative' or constraint.type == 'positive' %}
# {{ constraint.description | default('Minimum value for ' + constraint.field + ' (' + constraint.type + ')') }}
{{ constraint.name }} = Decimal("{{ constraint.value | default('0') }}")

{% elif constraint.type == 'range' or constraint.type == 'range_or_null' %}
{% if constraint.is_min %}
# {{ constraint.description | default('Minimum value for ' + constraint.field) }}
{{ constraint.name }} = Decimal("{{ constraint.value | default('0') }}")
{% else %}
# {{ constraint.description | default('Maximum value for ' + constraint.field) }}
{{ constraint.name }} = Decimal("{{ constraint.value | default('1') }}")
{% endif %}

{% else %}
# {{ constraint.description | default('Constraint for ' + constraint.field) }}
{{ constraint.name }} = {% if constraint.value is not none %}{% if constraint.type == 'integer' %}{{ constraint.value }}{% else %}Decimal("{{ constraint.value }}"){% endif %}{% else %}None{% endif %}

{% endif %}
{% endfor %}
