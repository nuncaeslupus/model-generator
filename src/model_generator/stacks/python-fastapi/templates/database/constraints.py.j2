def validate_percentage(value: Decimal | None, allow_null: bool = False) -> bool:
    """
    Validate that value is a valid percentage (0.0 to 1.0).

    Args:
        value: Decimal value to validate (or None)
        allow_null: Whether None/NULL is acceptable

    Returns:
        True if valid, False otherwise
    """
    if value is None:
        return allow_null
    return Decimal("0") <= value <= Decimal("1")


def validate_non_negative(value: Decimal) -> bool:
    """
    Validate that value is non-negative (>= 0).

    Used for: balances, volumes, fees, costs, counts

    Args:
        value: Decimal value to validate

    Returns:
        True if valid, False otherwise
    """
    return value >= Decimal("0")


def validate_positive(value: Decimal) -> bool:
    """
    Validate that value is positive (> 0).

    Used for: prices, quantities, sizes that cannot be zero

    Args:
        value: Decimal value to validate

    Returns:
        True if valid, False otherwise
    """
    return value > Decimal("0")


def validate_negative(value: Decimal) -> bool:
    """
    Validate that value is negative (< 0).

    Used for: losses, debts, negative P&L

    Args:
        value: Decimal value to validate

    Returns:
        True if valid, False otherwise
    """
    return value < Decimal("0")


def validate_non_positive(value: Decimal) -> bool:
    """
    Validate that value is non-positive (<= 0).

    Used for: values that can be zero or negative but not positive

    Args:
        value: Decimal value to validate

    Returns:
        True if valid, False otherwise
    """
    return value <= Decimal("0")


def validate_range(
    value: Decimal | None,
    min_val: Decimal,
    max_val: Decimal,
    allow_null: bool = False,
) -> bool:
    """
    Validate that value is within a specified range [min_val, max_val].

    Args:
        value: Decimal value to validate
        min_val: Minimum allowed value (inclusive)
        max_val: Maximum allowed value (inclusive)
        allow_null: Whether None/NULL is acceptable

    Returns:
        True if valid, False otherwise
    """
    if value is None:
        return allow_null
    return min_val <= value <= max_val


