{#-
  Dio setup template (two-file).

  ``which == "base"`` emits ``api_client.dart`` (overwrite): a factory that
  builds a configured [Dio] with the API base URL and — when the project enables
  an auth strategy — the generated auth interceptor. It delegates to the
  hand-editable ``api_client_custom.dart`` seam for project-specific tweaks.

  ``which == "custom"`` emits ``api_client_custom.dart`` (skip-if-exists): the
  hook adopters edit. Regeneration never clobbers it. Project-agnostic.
-#}
{% if which == 'base' %}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// Overwritten on regeneration — put project tweaks in api_client_custom.dart.

import 'package:dio/dio.dart';
{% if has_auth %}

import '{{ auth_interceptor_uri }}';
{% endif %}
import 'api_client_custom.dart';

/// Default base URL for the generated API client.
///
/// Points at the FastAPI backend's versioned API root (path prefix matching the
/// backend's router mount). Override per-environment via [buildApiClient].
const String kDefaultBaseUrl = '{{ base_url }}';

/// Build a configured [Dio] for the generated retrofit clients.
///
/// Wires the base URL{{ ', the auth interceptor,' if has_auth else '' }} and the
/// adopter-owned [configureApiClient] hook (see api_client_custom.dart).
Dio buildApiClient({
  String baseUrl = kDefaultBaseUrl,
{% if has_auth %}
  AuthTokenProvider? authTokenProvider,
{% endif %}
}) {
  final dio = Dio(
    BaseOptions(
      baseUrl: baseUrl,
      contentType: 'application/json',
{% if has_auth %}
      // Cookie-based strategies need credentials carried across requests.
      extra: const {'withCredentials': true},
{% endif %}
    ),
  );
{% if has_auth %}
  dio.interceptors.add(AuthInterceptor(tokenProvider: authTokenProvider));
{% endif %}
  configureApiClient(dio);
  return dio;
}
