{#-
  analysis_options.yaml — analyzer + lint config for the generated client.

  Excludes build_runner output from analysis and suppresses
  constant_identifier_names so the UPPER_CASE enum members (the project-wide
  convention) don't trip the linter.
-#}
# THIS CONFIG WAS INITIALLY GENERATED BY model-generator
include: package:flutter_lints/flutter.yaml

analyzer:
  exclude:
    - "**/*.freezed.dart"
    - "**/*.g.dart"

linter:
  rules:
    # Generated enum members are UPPER_CASE (matching the source spec and the
    # backend wire values), which intentionally violates the default Dart
    # lowerCamelCase rule for constants.
    constant_identifier_names: false
