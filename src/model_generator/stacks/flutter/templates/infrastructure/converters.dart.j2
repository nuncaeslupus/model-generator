// JsonConverters and fromJson/toJson helpers bridging Dart types to the
// backend's JSON wire format.

import 'dart:convert';
import 'dart:typed_data';

import 'package:decimal/decimal.dart';
import 'package:json_annotation/json_annotation.dart';

// ---------------------------------------------------------------------------
// Top-level fromJson / toJson helpers (used via @JsonKey in freezed models)
// ---------------------------------------------------------------------------

Decimal decimalFromJson(String json) => Decimal.parse(json);
String? decimalToJson(Decimal? object) => object?.toString();

Uint8List bytesFromJson(String json) => base64Decode(json);
String? bytesToJson(Uint8List? object) =>
    object == null ? null : base64Encode(object);

DateTime utcDateTimeFromJson(String json) => DateTime.parse(json).toUtc();
String? utcDateTimeToJson(DateTime? object) {
  if (object == null) return null;
  final utc = object.toUtc();
  return '${utc.toIso8601String().replaceFirst(RegExp(r'Z?$'), '')}Z';
}

