}

/// Binary blobs: base64-encoded strings on the wire, [Uint8List] in Dart.
class BytesConverter implements JsonConverter<Uint8List, String> {
  const BytesConverter();

  @override
  Uint8List fromJson(String json) => base64Decode(json);

  @override
