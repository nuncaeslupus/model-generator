// JsonConverter classes (retained for hand-written code / direct annotation)
// ---------------------------------------------------------------------------

/// Money / fixed-point values: carried as a JSON **string** (byte-compatible
/// with the FastAPI Numeric serialization) and decoded to [Decimal].
class DecimalConverter implements JsonConverter<Decimal, String> {
  const DecimalConverter();

  @override
  Decimal fromJson(String json) => decimalFromJson(json);

  @override
  String toJson(Decimal object) => object.toString();
}

/// Binary blobs: base64-encoded strings on the wire, [Uint8List] in Dart.
class BytesConverter implements JsonConverter<Uint8List, String> {
  const BytesConverter();

  @override
  Uint8List fromJson(String json) => bytesFromJson(json);

  @override
  String toJson(Uint8List object) => base64Encode(object);
}

/// Timestamps: ISO8601 strings with a trailing `Z` (UTC). Round-trips to a
/// UTC [DateTime] so equality with the backend payload is preserved.
class UtcDateTimeConverter implements JsonConverter<DateTime, String> {
  const UtcDateTimeConverter();

  @override
  DateTime fromJson(String json) => utcDateTimeFromJson(json);

  @override
  String toJson(DateTime object) {
    final utc = object.toUtc();
    return '${utc.toIso8601String().replaceFirst(RegExp(r'Z?$'), '')}Z';
  }
}
