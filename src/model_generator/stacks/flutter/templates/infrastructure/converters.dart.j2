/// Money / fixed-point values: carried as a JSON **string** (byte-compatible
/// with the FastAPI Numeric serialization) and decoded to [Decimal].
class DecimalConverter implements JsonConverter<Decimal, String> {
  const DecimalConverter();

  @override
