{#-
  Auth interceptor template (conditional on auth.strategy).

  ``strategy == "api-key"``  → attach the configured API-key header to every
                               request (header name from auth config).
  ``strategy == "bcrypt-session"`` → cookie passthrough: the backend sets a
                               signed session cookie; dio's withCredentials carries
                               it, and this interceptor adds the CSRF double-submit
                               header from the cookie on unsafe methods.

  The strategy is resolved coarsely in Python; this template only renders the
  branch it was given. Project-agnostic — header names come from config.
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// Auth interceptor wiring the {{ strategy }} strategy onto outgoing requests.

import 'package:dio/dio.dart';

{% if strategy == 'api-key' %}
/// Supplies the API key sent on every request, or null when unauthenticated.
typedef AuthTokenProvider = String? Function();

/// Attaches the configured API-key header to outgoing requests.
class AuthInterceptor extends Interceptor {
  AuthInterceptor({this.tokenProvider});

  /// Header name the backend expects the key on.
  static const String headerName = '{{ header_name }}';

  final AuthTokenProvider? tokenProvider;

  @override
  void onRequest(RequestOptions options, RequestInterceptorHandler handler) {
    final key = tokenProvider?.call();
    if (key != null && key.isNotEmpty) {
      options.headers[headerName] = key;
    }
    handler.next(options);
  }
}
{% else %}
/// Cookie strategies need no token from the app; kept for a uniform
/// `buildApiClient` signature across strategies.
typedef AuthTokenProvider = String? Function();

/// Cookie-passthrough interceptor for the session strategy.
///
/// The backend issues a signed session cookie on login; dio's `withCredentials`
/// carries it automatically. On unsafe methods this interceptor echoes the CSRF
/// token from the `{{ csrf_cookie }}` cookie into the `{{ csrf_header }}` header
/// to satisfy the backend's double-submit-cookie check.
class AuthInterceptor extends Interceptor {
  AuthInterceptor({this.tokenProvider});

  static const String csrfCookieName = '{{ csrf_cookie }}';
  static const String csrfHeaderName = '{{ csrf_header }}';
  static const Set<String> _unsafeMethods = {'POST', 'PUT', 'PATCH', 'DELETE'};

  final AuthTokenProvider? tokenProvider;

  @override
  void onRequest(RequestOptions options, RequestInterceptorHandler handler) {
    // Runtime caveat — cookie availability on `options.headers`:
    //
    // Reading the CSRF token from the `cookie` request header (see
    // `_readCookie`) depends on the cookie actually being present there, which
    // is NOT guaranteed across platforms:
    //   * On Web, the browser owns the cookie jar and auto-attaches cookies to
    //     same-origin requests; it never exposes them in `RequestOptions.headers`.
    //     The double-submit header is therefore typically unnecessary there (the
    //     browser already sends the cookie), and this read will simply find
    //     nothing — that is expected, not a bug.
    //   * On mobile/desktop, Dio does not manage cookies on its own. The cookie
    //     only appears here if `dio_cookie_manager` (or an equivalent manager)
    //     is installed and ordered to run BEFORE this interceptor, so the
    //     stored cookie is populated onto the request first.
    // If you rely on the double-submit header off the Web, ensure a cookie
    // manager precedes this interceptor in the Dio interceptor chain.
    if (_unsafeMethods.contains(options.method.toUpperCase())) {
      final token = _readCookie(options, csrfCookieName);
      if (token != null && token.isNotEmpty) {
        options.headers[csrfHeaderName] = token;
      }
    }
    handler.next(options);
  }

  String? _readCookie(RequestOptions options, String name) {
    final raw = options.headers[HttpHeadersCookie];
    if (raw is! String) {
      return null;
    }
    for (final part in raw.split(';')) {
      final trimmed = part.trim();
      if (trimmed.startsWith('$name=')) {
        return trimmed.substring(name.length + 1);
      }
    }
    return null;
  }
}

/// The HTTP cookie header name (avoids importing dart:io for a constant).
const String HttpHeadersCookie = 'cookie';
{% endif %}
