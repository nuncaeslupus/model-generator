{#-
  pubspec.yaml — the Dart project manifest (pyproject.toml analogue).

  Bootstrap-only: emitted once when no pubspec.yaml exists, then hand-maintained.
  Dependency lists are passed in from config; versions are intentionally left
  unpinned (``any``) so the user resolves them with ``dart pub get`` against the
  current SDK — the generator never shells out to pub.
-#}
{#-
  Version pins for packages that have known issues at certain versions.
  Without explicit constraints, `dart pub get` may resolve a dev pre-release
  (e.g. freezed 4.0.0-dev.3) or a version with regressions.
  - json_serializable 6.14.0 introduced a breaking change: it validates enum
    types as InvalidType even when @JsonKey(fromJson:) is supplied, which breaks
    external enum serialization. Pin below 6.14.0 until upstream is fixed.
-#}
{% set _pins = {
  'freezed': '^3.0.0',
  'freezed_annotation': '^3.0.0',
  'json_serializable': '>=6.7.0 <6.14.0',
} %}
name: {{ package_name }}
description: {{ project_description | default(project_name | default("Generated Dart client.")) }}
publish_to: "none"
version: 0.1.0

environment:
  sdk: "^3.8.0"

dependencies:
{% for dep in runtime_deps %}
  {{ dep }}: "{{ _pins.get(dep, 'any') }}"
{% endfor %}

dev_dependencies:
{% for dep in dev_deps %}
  {{ dep }}: "{{ _pins.get(dep, 'any') }}"
{% endfor %}
