{#-
  Drift Table template (Phase 4).

  Emits ``<entity>_table.dart`` under ``lib/local/``.  One file per
  API-enabled entity; each carries a Drift ``Table`` subclass that defines
  the local SQLite schema for the entity's cache.

  Column types mirror the abstract field types from the spec:
    text    → uuid, reference, text, longtext, financial, percentage, enum,
              json_object, json_array  (the last four need conversion helpers)
    integer → counter / integer
    boolean → boolean
    dateTime → datetime
    blob    → binary

  ``table_name`` is pre-resolved in Python (``local_<entity_table>``),
  ensuring the local schema never collides with backend table names.

  Variables injected by ``generate_drift_tables``:
    entity_name   PascalCase entity name
    table_class   Dart class name, e.g. ``CategoryTable``
    table_name    SQL table name, e.g. ``local_categories``
    pk_field      camelCase PK column name, e.g. ``id``
    fields        list of field descriptors (name, drift_col_type,
                  drift_builder, nullable)
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// DO NOT EDIT — regenerated from the spec on every model-gen run.

import 'package:drift/drift.dart';

/// Drift table definition for [{{ entity_name }}].
///
/// Mirrors the spec fields so the local SQLite cache has the same shape as
/// the API wire format.  [AppDatabase] aggregates all generated tables;
/// [{{ entity_name }}CachedRepository] queries this table for offline reads.
class {{ table_class }} extends Table {
  @override
  String get tableName => '{{ table_name }}';

{% for field in fields %}
  {{ field.drift_col_type }} get {{ field.name }} => {{ field.drift_builder }}(){% if field.nullable %}.nullable(){% endif %}();
{% endfor %}
  @override
  Set<Column> get primaryKey => { {{ pk_field }} };
}
