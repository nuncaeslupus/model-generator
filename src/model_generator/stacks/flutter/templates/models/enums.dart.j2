{#-
  Enum definitions template.

  Emits one Dart ``enum`` per shared enum. Members are UPPER_CASE and each
  carries a ``@JsonValue('UPPER_CASE')`` for documentation (the wire value is
  the same as the Dart member name for all UPPER_CASE enums).

  Per-enum ``fromJson``/``toJson`` top-level helpers use Dart's built-in
  ``.values.byName()`` / ``.name`` instead of the json_serializable-generated
  ``_$EnumNameEnumMap``.  This avoids a ``part 'enums.g.dart'`` directive which
  would prevent the Dart analyser from fully resolving ``enums.dart`` before the
  generated file exists, causing ``ProductStatus`` to appear as ``InvalidType``
  and breaking ``@JsonKey(fromJson:)`` in model files.

  Driven entirely by the shared enums.json — no project-specific names
  appear in this template.
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// Enum definitions shared across the generated models.
//
// All members are UPPER_CASE and pinned to their wire value via @JsonValue,
// matching the UPPER_CASE convention used everywhere in the source spec.

import 'package:json_annotation/json_annotation.dart';

{% for enum_name, enum_def in enums.items() %}
{% set fn_prefix = enum_name[0] | lower + enum_name[1:] %}
{% if enum_def.description %}
/// {{ enum_def.description }}
{% endif %}
enum {{ enum_name }} {
{% for value in enum_def["values"] %}
{% if value is mapping %}
{% if value.description %}
  /// {{ value.description }}
{% endif %}
  @JsonValue('{{ value.value | upper }}')
  {{ value.name | upper }},
{% else %}
  @JsonValue('{{ value | upper }}')
  {{ value | upper }},
{% endif %}
{% endfor %}
}

{{ enum_name }} {{ fn_prefix }}FromJson(Object? json) =>
    {{ enum_name }}.values.byName(json as String);
String {{ fn_prefix }}ToJson({{ enum_name }} object) => object.name;

{% endfor %}
