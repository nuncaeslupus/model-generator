{#-
  Enum definitions template.

  Emits one Dart ``enum`` per shared enum. Members are UPPER_CASE and each
  carries a ``@JsonValue('UPPER_CASE')`` so the wire value is documented.

  Each enum is annotated with ``@JsonEnum(alwaysCreate: true)``, which
  instructs json_serializable to generate an ``_$EnumNameEnumMap`` constant
  into ``enums.g.dart`` (via the ``part 'enums.g.dart'`` directive below).
  This makes the enum type recognisable to json_serializable when it
  processes model files that import this library — without it, enums
  imported from an external library are treated as ``InvalidType`` by
  json_serializable 6.7+ and cannot be serialised.

  The ``part 'enums.g.dart'`` directive is required so json_serializable
  has a file to write the generated map into.

  Driven entirely by the shared enums.json — no project-specific names
  appear in this template.
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// Enum definitions shared across the generated models.
//
// All members are UPPER_CASE and pinned to their wire value via @JsonValue,
// matching the UPPER_CASE convention used everywhere in the source spec.

import 'package:json_annotation/json_annotation.dart';

part 'enums.g.dart';

{% for enum_name, enum_def in enums.items() %}
{% set fn_prefix = enum_name[0] | lower + enum_name[1:] %}
{% if enum_def.description %}
/// {{ enum_def.description }}
{% endif %}
@JsonEnum(alwaysCreate: true)
enum {{ enum_name }} {
{% for value in enum_def["values"] %}
{% if value is mapping %}
{% if value.description %}
  /// {{ value.description }}
{% endif %}
  @JsonValue('{{ value.value | upper }}')
  {{ value.name | upper }},
{% else %}
  @JsonValue('{{ value | upper }}')
  {{ value | upper }},
{% endif %}
{% endfor %}
}

{{ enum_name }} {{ fn_prefix }}FromJson(Object? json) =>
    $enumDecode(_${{ enum_name }}EnumMap, json);
String {{ fn_prefix }}ToJson({{ enum_name }} object) =>
    _${{ enum_name }}EnumMap[object]!;

{% endfor %}
