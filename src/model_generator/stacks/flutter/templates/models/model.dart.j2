{#-
  Freezed model template.

  Emits a single ``@freezed`` data class for one entity. Field types, JsonKey
  names, converters and nullability are pre-resolved in Python (generators/
  flutter/fields.py) and passed in as ``fields`` — this template stays purely
  presentational and project-agnostic (no hardcoded entity names/paths/imports).
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// To regenerate the companion *.freezed.dart / *.g.dart files, run:
//   dart run build_runner build --delete-conflicting-outputs

import 'package:freezed_annotation/freezed_annotation.dart';
{% for imp in dart_imports %}
import '{{ imp }}';
{% endfor %}
{% if needs_converters %}
import '{{ converters_uri }}';
{% endif %}
{% if needs_enums %}
import '{{ enums_uri }}';
{% endif %}

part '{{ file_stem }}.freezed.dart';
part '{{ file_stem }}.g.dart';

{% if description %}
/// {{ description }}
{% endif %}
@freezed
class {{ entity_name }} with _${{ entity_name }} {
  const factory {{ entity_name }}({
{% for field in fields %}
{% for line in field.doc %}
    /// {{ line }}
{% endfor %}
{% if field.needs_json_key %}
    @JsonKey(name: '{{ field.json_key }}')
{% endif %}
{% if field.converter %}
    @{{ field.converter }}()
{% endif %}
{% if field.nullable %}
    {{ field.dart_type }}? {{ field.name }},
{% else %}
    required {{ field.dart_type }} {{ field.name }},
{% endif %}
{% endfor %}
  }) = _{{ entity_name }};

  factory {{ entity_name }}.fromJson(Map<String, dynamic> json) =>
      _${{ entity_name }}FromJson(json);
}
