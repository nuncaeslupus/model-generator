{#-
  Cache-first repository template (Phase 4).

  Emits ``<entity>_cached_repository.dart`` for each API-enabled entity.
  The class extends the Phase-2 base repository (``<Entity>Repository``) and
  wraps every operation with a Drift/SQLite cache layer:

    list()     — cache-first for non-paginated/non-filtered lists; paginated
                 or filtered calls always go to the network.
    getById()  — cache-first; falls back to network and populates cache.
    create()   — write-through (network → upsert cache).
    update()   — write-through (network → upsert cache).
    delete()   — write-through (network → remove from cache).

  Private helpers ``_fromRow`` / ``_toCompanion`` handle the storage ↔ model
  type conversions (Decimal ↔ String, enum ↔ .name, JSON ↔ string, etc.).

  To activate: update ``<entity>_repository_custom.dart`` to extend
  [cached_class] instead of [base_class], and pass an [AppDatabase] to the
  constructor.  The adopter's ``_custom.dart`` file is the correct seam for
  any further project-specific logic.

  Variables injected by ``generate_cached_repositories``:
    entity_name          PascalCase entity name
    base_class           e.g. CategoryRepository
    cached_class         e.g. CategoryCachedRepository
    custom_class         e.g. CategoryRepositoryCustom
    table_db_accessor    e.g. categoryTable (AppDatabase getter)
    table_data_type      e.g. CategoryTableData
    table_companion_type e.g. CategoryTableCompanion
    ops                  list of op descriptors (same as Phase-2 repository)
    filters              list of filter param descriptors
    cache_fields         list of {name, from_row, to_companion} per field
    pk_field             primary-key Dart member name (for WHERE clause)
    has_requests         bool — whether Create/Update DTOs exist
    needs_decimal        bool — import decimal package
    needs_json           bool — import dart:convert
    needs_enums          bool — import enums barrel
    *_uri                package import URIs
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// Overwritten on regeneration — extend [{{ custom_class }}] for project-specific logic.

{% if needs_json %}
import 'dart:convert';

{% endif %}
import 'package:decimal/decimal.dart' show Decimal;
import 'package:drift/drift.dart' show Value;

import '{{ model_uri }}';
import '{{ repository_uri }}';
import '{{ local_database_uri }}';
{% if needs_pagination %}
import '{{ pagination_uri }}';
{% endif %}
{% if has_requests %}
import '{{ requests_uri }}';
{% endif %}
{% if needs_enums %}
import '{{ enums_uri }}';
{% endif %}

/// Cache-first repository for [{{ entity_name }}] backed by Drift/SQLite.
///
/// Extends [{{ base_class }}] to add a local SQLite read-through cache so the
/// app can read [{{ entity_name }}] data while offline.  Mutations go to the
/// network first and are reflected in the cache on success.
///
/// **To activate:** in ``{{ entity_name | lower }}_repository_custom.dart``, change
/// ``extends {{ base_class }}`` → ``extends {{ cached_class }}`` and update
/// the constructor to accept an [AppDatabase]:
/// ```dart
/// class {{ custom_class }} extends {{ cached_class }} {
///   {{ custom_class }}(super.client, super.db);
/// }
/// ```
/// Then inject [AppDatabase] wherever [{{ custom_class }}] is created.
class {{ cached_class }} extends {{ base_class }} {
  {{ cached_class }}(super.client, this._db);

  final AppDatabase _db;

{% for op in ops %}
{% if op.kind == 'list' %}
  /// List [{{ entity_name }}] records.
  ///
{% if op.paginated or filters %}
  /// Paginated / filtered lists delegate to the network — per-page and
  /// per-filter cache keying is outside the scope of this layer.
{% else %}
  /// Cache-first: returns the local cache when populated; fetches from the
  /// network on cache miss and stores the result.
{% endif %}
  @override
  Future<{{ op.return_type }}> list({
{% if op.paginated %}
    int? page,
    int? pageSize,
{% endif %}
{% for f in filters %}
    {{ f.dart_type }}? {{ f.name }},
{% endfor %}
  }) async {
{% if op.paginated or filters %}
    return super.list(
{% if op.paginated %}
      page: page,
      pageSize: pageSize,
{% endif %}
{% for f in filters %}
      {{ f.name }}: {{ f.name }},
{% endfor %}
    );
{% else %}
    final rows = await _db.select(_db.{{ table_db_accessor }}).get();
    if (rows.isNotEmpty) return rows.map(_fromRow).toList();
    final remote = await super.list();
    await _db.batch(
      (b) => b.insertAllOnConflictUpdate(
        _db.{{ table_db_accessor }},
        remote.map(_toCompanion),
      ),
    );
    return remote;
{% endif %}
  }

{% elif op.kind == 'get' %}
  /// Fetch a single [{{ entity_name }}] by id — cache-first.
  ///
  /// Returns the cached row when present; otherwise fetches from the network
  /// and stores the result in the cache.
  @override
  Future<{{ op.return_type }}> getById({{ op.id_type }} {{ op.id_param }}) async {
    final row = await (
      _db.select(_db.{{ table_db_accessor }})
        ..where((t) => t.{{ pk_field }}.equals({{ op.id_param }}))
    ).getSingleOrNull();
    if (row != null) return _fromRow(row);
    final remote = await super.getById({{ op.id_param }});
    await _db
        .into(_db.{{ table_db_accessor }})
        .insertOnConflictUpdate(_toCompanion(remote));
    return remote;
  }

{% elif op.kind == 'create' %}
  /// Create a [{{ entity_name }}] — write-through to network then cache.
  @override
  Future<{{ op.return_type }}> create({{ op.body_type }} body) async {
    final result = await super.create(body);
    await _db
        .into(_db.{{ table_db_accessor }})
        .insertOnConflictUpdate(_toCompanion(result));
    return result;
  }

{% elif op.kind == 'update' %}
  /// Update a [{{ entity_name }}] — write-through to network then cache.
  @override
  Future<{{ op.return_type }}> update(
    {{ op.id_type }} {{ op.id_param }},
    {{ op.body_type }} body,
  ) async {
    final result = await super.update({{ op.id_param }}, body);
    await _db
        .into(_db.{{ table_db_accessor }})
        .insertOnConflictUpdate(_toCompanion(result));
    return result;
  }

{% elif op.kind == 'delete' %}
  /// Delete a [{{ entity_name }}] — remove from network then cache.
  @override
  Future<void> delete({{ op.id_type }} {{ op.id_param }}) async {
    await super.delete({{ op.id_param }});
    await (
      _db.delete(_db.{{ table_db_accessor }})
        ..where((t) => t.{{ pk_field }}.equals({{ op.id_param }}))
    ).go();
  }

{% endif %}
{% endfor %}
  // ---------------------------------------------------------------------------
  // Private helpers — row ↔ model mapping
  // ---------------------------------------------------------------------------

  {{ entity_name }} _fromRow({{ table_data_type }} row) {
    return {{ entity_name }}(
{% for f in cache_fields %}
      {{ f.name }}: {{ f.from_row }},
{% endfor %}
    );
  }

  {{ table_companion_type }} _toCompanion({{ entity_name }} e) {
    return {{ table_companion_type }}(
{% for f in cache_fields %}
      {{ f.name }}: {{ f.to_companion }},
{% endfor %}
    );
  }
}
