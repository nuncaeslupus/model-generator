{#-
  Retrofit API client template.

  Emits one ``@RestApi`` abstract class per API-enabled entity. The endpoint
  set, HTTP verbs, path, pagination return type and query filters are all
  pre-resolved in Python (generators/flutter/api.py) and passed in as ``ops`` and
  ``filters`` — this template stays purely presentational and project-agnostic
  (no hardcoded entity names, paths, package names or imports).
-#}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// To regenerate the companion *.g.dart file, run:
//   dart run build_runner build --delete-conflicting-outputs

import 'package:dio/dio.dart';
import 'package:retrofit/retrofit.dart';

import '{{ model_uri }}';
{% if needs_pagination %}
import '{{ pagination_uri }}';
{% endif %}
{% if needs_requests %}
import '{{ requests_uri }}';
{% endif %}

part '{{ file_stem }}.g.dart';

/// Typed retrofit client for the {{ entity_name }} endpoints.
///
/// Construct via [{{ class_name }}.new] with a configured [Dio] (see the core
/// api_client). The base URL already carries the API prefix; method paths are
/// relative to it.
@RestApi()
abstract class {{ class_name }} {
  factory {{ class_name }}(Dio dio, {String? baseUrl}) = _{{ class_name }};

{% for op in ops %}
{% if op.kind == 'list' %}
  /// List {{ entity_name }} records{{ ' (paginated)' if op.paginated else '' }}.
  @GET('{{ op.path }}')
  Future<{{ op.return_type }}> {{ op.method }}({
{% if op.paginated %}
    @Query('page') int? page,
    @Query('page_size') int? pageSize,
{% endif %}
{% for f in filters %}
    @Query('{{ f.query }}') {{ f.dart_type }}? {{ f.name }},
{% endfor %}
  });
{% elif op.kind == 'get' %}
  /// Fetch a single {{ entity_name }} by id.
  @GET('{{ op.path }}')
  Future<{{ op.return_type }}> {{ op.method }}(@Path('{{ op.id_key }}') {{ op.id_type }} {{ op.id_param }});
{% elif op.kind == 'create' %}
  /// Create a new {{ entity_name }}.
  @POST('{{ op.path }}')
  Future<{{ op.return_type }}> {{ op.method }}(@Body() {{ op.body_type }} body);
{% elif op.kind == 'update' %}
  /// Update an existing {{ entity_name }}.
  @{{ op.verb }}('{{ op.path }}')
  Future<{{ op.return_type }}> {{ op.method }}(
    @Path('{{ op.id_key }}') {{ op.id_type }} {{ op.id_param }},
    @Body() {{ op.body_type }} body,
  );
{% elif op.kind == 'delete' %}
  /// Delete a {{ entity_name }} by id.
  @DELETE('{{ op.path }}')
  Future<void> {{ op.method }}(@Path('{{ op.id_key }}') {{ op.id_type }} {{ op.id_param }});
{% endif %}

{% endfor %}
}
