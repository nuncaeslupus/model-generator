{#-
  Repository wrapper template (two-file).

  ``which == "base"`` emits ``<entity>_repository.dart`` (overwrite): a thin
  wrapper delegating to the generated retrofit client. It is the seam Phase 4's
  offline cache slots behind — the app depends on the repository, not the client
  directly, so a cache can be layered in without touching call sites.

  ``which == "custom"`` emits ``<entity>_repository_custom.dart``
  (skip-if-exists): the hand-editable subclass adopters extend. Regeneration
  never clobbers it. Endpoint methods mirror the retrofit client's ``ops``.
  Project-agnostic — all names derived from the spec.
-#}
{% if which == 'base' %}
// THIS CODE WAS INITIALLY GENERATED BY model-generator
// Overwritten on regeneration — extend {{ custom_class }} for custom logic.

import '{{ api_uri }}';
import '{{ model_uri }}';
{% if needs_pagination %}
import '{{ pagination_uri }}';
{% endif %}
{% if needs_requests %}
import '{{ requests_uri }}';
{% endif %}

/// Thin repository over [{{ client_class }}] for {{ entity_name }}.
///
/// Wraps the retrofit client so call sites depend on a repository abstraction —
/// the seam an offline cache layer plugs behind (see {{ custom_class }}).
class {{ base_class }} {
  {{ base_class }}(this.client);

  final {{ client_class }} client;

{% for op in ops %}
{% if op.kind == 'list' %}
  /// List {{ entity_name }} records{{ ' (paginated)' if op.paginated else '' }}.
  Future<{{ op.return_type }}> {{ op.method }}({
{% if op.paginated %}
    int? page,
    int? pageSize,
{% endif %}
{% for f in filters %}
    {{ f.dart_type }}? {{ f.name }},
{% endfor %}
  }) {
    return client.{{ op.method }}(
{% if op.paginated %}
      page: page,
      pageSize: pageSize,
{% endif %}
{% for f in filters %}
      {{ f.name }}: {{ f.name }},
{% endfor %}
    );
  }
{% elif op.kind == 'get' %}
  /// Fetch a single {{ entity_name }} by id.
  Future<{{ op.return_type }}> {{ op.method }}({{ op.id_type }} {{ op.id_param }}) {
    return client.{{ op.method }}({{ op.id_param }});
  }
{% elif op.kind == 'create' %}
  /// Create a new {{ entity_name }}.
  Future<{{ op.return_type }}> {{ op.method }}({{ op.body_type }} body) {
    return client.{{ op.method }}(body);
  }
{% elif op.kind == 'update' %}
  /// Update an existing {{ entity_name }}.
  Future<{{ op.return_type }}> {{ op.method }}({{ op.id_type }} {{ op.id_param }}, {{ op.body_type }} body) {
    return client.{{ op.method }}({{ op.id_param }}, body);
  }
{% elif op.kind == 'delete' %}
  /// Delete a {{ entity_name }} by id.
  Future<void> {{ op.method }}({{ op.id_type }} {{ op.id_param }}) {
    return client.{{ op.method }}({{ op.id_param }});
  }
{% endif %}

{% endfor %}
}
{% else %}
// THIS FILE WAS GENERATED ONCE BY model-generator AS A STARTING POINT.
// It is NOT overwritten on regeneration — customize it freely.

import '{{ repository_uri }}';
import '{{ api_uri }}';

/// Project-specific repository for {{ entity_name }}.
///
/// Extends the generated [{{ base_class }}]. This is where an offline cache
/// (Phase 4) or other app-specific behavior layers in — override methods here
/// without touching the regenerated base class.
class {{ custom_class }} extends {{ base_class }} {
  {{ custom_class }}(super.client);
}
{% endif %}
